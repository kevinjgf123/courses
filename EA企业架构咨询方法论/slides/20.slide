<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            AA 之内容：应用组合清单、<span style={{ color: '#FA4F24' }}>集成关系</span>与架构原则
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            清单解决「有什么」，关系图解决「怎么连」，架构原则解决「以后怎么建」
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 非对称双栏 62:38 */}
    <Box style={{ paddingTop: 22, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 28 }}>

        {/* 左 62% 清单 + 关系图 */}
        <Box style={{ flex: 62, flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423' }}>交付物一 · 应用组合清单</Text>
            <Box style={{ height: 142, flexDirection: 'column', gap: 3 }}>
                <Box style={{ height: 28, flexDirection: 'row', gap: 4 }}>
                    {['应用名称', '承载能力', '技术健康度', '业务价值', '决策'].map((t, i) => (
                        <Box key={i} style={{ flex: i === 1 ? 2 : 1, background: '#0F1423', borderRadius: 2, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 13, color: '#FFFFFF', textAlign: 'center' }}>{t}</Text>
                        </Box>
                    ))}
                </Box>
                {[
                    ['订单中心', '订单履约', 'B', 'A', '保留'],
                    ['CRM 旧版', '客户管理', 'D', 'B', '退役'],
                    ['报表工具 X', '经营分析', 'C', 'C', '集成'],
                    ['产线 MES', '生产执行', 'B', 'A', '保留'],
                ].map((row, i) => (
                    <Box key={i} style={{ height: 25, flexDirection: 'row', gap: 4 }}>
                        {row.map((v, j) => (
                            <Box key={j} style={{ flex: j === 1 ? 2 : 1, background: i % 2 === 0 ? '#F7F7F8' : '#FBFBFC', borderRadius: 2, justifyContent: 'center' }}>
                                <Text style={{ fontSize: 13, color: j === 0 ? '#0F1423' : '#5A5F6B', textAlign: 'center' }}>{v}</Text>
                            </Box>
                        ))}
                    </Box>
                ))}
            </Box>

            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423', marginTop: 2 }}>交付物二 · 应用集成关系图</Text>
            <Box style={{ flex: 1, background: '#FBFBFC', borderRadius: 4, padding: 14 }}>
                <Box style={{ height: '100%', flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ flexDirection: 'column', gap: 16, width: 120 }}>
                        <Box style={{ height: 52, background: '#FA4F24', borderRadius: 3, justifyContent: 'center', alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>CRM 前端</Text>
                        </Box>
                        <Box style={{ height: 52, background: '#FBA47A', borderRadius: 3, justifyContent: 'center', alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#3A1A0A' }}>MES 前端</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 18, color: '#C9CBD1', flex: 1, textAlign: 'center' }}>⟶</Text>
                    <Box style={{ width: 116, height: 120, border: '1.5px solid #FA4F24', borderRadius: 3, justifyContent: 'center', alignItems: 'center', flexDirection: 'column' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FA4F24' }}>集成总线</Text>
                        <Text style={{ fontSize: 13, color: '#8A8F99', marginTop: 6 }}>API Gateway</Text>
                    </Box>
                    <Text style={{ fontSize: 18, color: '#C9CBD1', flex: 1, textAlign: 'center' }}>⟶</Text>
                    <Box style={{ flexDirection: 'column', gap: 16, width: 120 }}>
                        <Box style={{ height: 52, background: '#F87D2F', borderRadius: 3, justifyContent: 'center', alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>订单中心</Text>
                        </Box>
                        <Box style={{ height: 52, background: '#F1F2F4', borderRadius: 3, justifyContent: 'center', alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#5A5F6B' }}>数据底座</Text>
                        </Box>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 右 38% 架构原则 */}
        <Box style={{ flex: 38, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423' }}>交付物三 · 架构原则</Text>
            {[
                { n: 'P1', t: '核心自建，非核采购', d: '核心能力定制获取差异化，非核心优先成熟产品。' },
                { n: 'P2', t: '优先 SaaS 而非自建', d: '无差异化诉求的能力不自建，降低维护负担。' },
                { n: 'P3', t: '集成优于重建', d: '能通过接口复用的，不得另建平行系统。' },
                { n: 'P4', t: '定期组合评审', d: '每年评估应用组合，淘汰冗余与过时应用。' },
            ].map((it, i) => (
                <Box key={i} style={{ height: 98, background: '#F7F7F8', borderRadius: 4, padding: '12px 16px', flexDirection: 'column', borderLeft: '4px solid #FA4F24' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FA4F24' }}>{it.n}</Text>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423', marginTop: 6 }}>{it.t}</Text>
                    <Text style={{ fontSize: 15, color: '#3A4050', marginTop: 6, lineHeight: 1.45 }}>{it.d}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · EA企业架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>20 / 26</Text>
    </Box>
</Slide>
