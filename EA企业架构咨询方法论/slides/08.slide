<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            愿景定义<span style={{ color: '#FA4F24' }}>「去哪」</span>，战略回答<span style={{ color: '#FA4F24' }}>「怎么去」</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            五层递进：愿景 → 使命 → 战略 → 举措 → KPI，每一层都必须能被上一层追溯
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 左大图 58% + 右侧文字 */}
    <Box style={{ paddingTop: 26, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 32 }}>

        {/* 左 58% 战略金字塔（SVG 骨架 + 文本层） */}
        <Box style={{ flex: 58, position: 'relative' }}>
            <svg width="640" height="400" style={{ position: 'absolute', top: 0, left: 0 }}>
                {/* 五层梯形（上小下大） */}
                <polygon points="288,0 352,0 384,72 256,72" fill="#B32C0C" />
                <polygon points="256,75 384,75 416,147 224,147" fill="#FA4F24" />
                <polygon points="224,150 416,150 448,222 192,222" fill="#F87D2F" />
                <polygon points="192,225 448,225 480,297 160,297" fill="#FBA47A" />
                <polygon points="160,300 480,300 512,372 128,372" fill="#FDD5BE" />
            </svg>
            {/* 层内文本（独立可编辑） */}
            <Box style={{ position: 'absolute', top: 0, left: 0, width: 640, height: 400, flexDirection: 'column' }}>
                {[
                    { h: 72, g: 3, label: '愿景', sub: '我们要成为什么', color: '#FFFFFF' },
                    { h: 72, g: 8, label: '使命', sub: '我们为谁创造价值', color: '#FFFFFF' },
                    { h: 72, g: 8, label: '战略', sub: '选择的路径与取舍', color: '#FFFFFF' },
                    { h: 72, g: 8, label: '举措', sub: '可投资的关键动作', color: '#3A1A0A' },
                    { h: 72, g: 8, label: 'KPI', sub: '如何度量成功', color: '#3A1A0A' },
                ].map((it, i) => (
                    <Box key={i} style={{
                        height: it.h, marginBottom: it.g, flexDirection: 'column',
                        justifyContent: 'center', alignItems: 'center', gap: 2,
                        marginTop: i === 0 ? 0 : 0,
                    }}>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: it.color }}>{it.label}</Text>
                        <Text style={{ fontSize: 14, color: it.color }}>{it.sub}</Text>
                    </Box>
                ))}
            </Box>
            {/* 右侧向上箭头 */}
            <Box style={{ position: 'absolute', top: 4, left: 556, flexDirection: 'column', alignItems: 'center' }}>
                <Text style={{ fontSize: 18, color: '#FA4F24' }}>↑</Text>
                <Box style={{ width: 2, height: 340, background: '#FA4F24', opacity: 0.35 }} />
            </Box>
        </Box>

        {/* 右 42% 解读 */}
        <Box style={{ flex: 42, flexDirection: 'column', gap: 14 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F1423' }}>
                三层解读
            </Text>
            {[
                { t: '愿景与使命：定方向', d: '愿景是不可量化的方向感，使命回答存在的意义 —— 二者是战略的天花板。' },
                { t: '战略：定取舍', d: '战略的本质是「不做什么」。业务战略明确市场与模式选择，IT 战略明确支撑方式。' },
                { t: '举措与 KPI：定节奏', d: '把战略拆成可投资的举措，再用 KPI 锁定度量口径 —— 否则战略无法被验证。' },
            ].map((it, i) => (
                <Box key={i} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '16px 20px', borderLeft: '4px solid #FA4F24' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F1423' }}>{it.t}</Text>
                    <Text style={{ fontSize: 17, color: '#3A4050', marginTop: 8, lineHeight: 1.5 }}>{it.d}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · EA企业架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>08 / 26</Text>
    </Box>
</Slide>
