<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            TA 之内容：技术组件、<span style={{ color: '#FA4F24' }}>部署视图</span>与标准规范
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            组件清单解决「用什么」，部署视图解决「放哪里」，标准规范解决「怎么管」
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 非对称双栏 62:38 */}
    <Box style={{ paddingTop: 22, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 28 }}>

        {/* 左 62% 组件清单 + 部署视图 */}
        <Box style={{ flex: 62, flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423' }}>交付物一 · 技术组件清单</Text>
            <Box style={{ height: 142, flexDirection: 'column', gap: 3 }}>
                <Box style={{ height: 28, flexDirection: 'row', gap: 4 }}>
                    {['技术层', '代表性组件', '成熟度', '锁定风险', '策略'].map((t, i) => (
                        <Box key={i} style={{ flex: i === 1 ? 2 : 1, background: '#0F1423', borderRadius: 2, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 13, color: '#FFFFFF', textAlign: 'center' }}>{t}</Text>
                        </Box>
                    ))}
                </Box>
                {[
                    ['基础设施', '容器平台 / 云主机', '高', '中', '云原生'],
                    ['数据平台', '数据湖 / 数仓', '高', '低', '湖仓一体'],
                    ['集成层', 'API 网关 / 消息', '高', '低', '统一网关'],
                    ['安全层', '统一身份 / 审计', '中', '低', '零信任'],
                ].map((row, i) => (
                    <Box key={i} style={{ height: 25, flexDirection: 'row', gap: 4 }}>
                        {row.map((v, j) => (
                            <Box key={j} style={{ flex: j === 1 ? 2 : 1, background: i % 2 === 0 ? '#F7F7F8' : '#FBFBFC', borderRadius: 2, justifyContent: 'center' }}>
                                <Text style={{ fontSize: 13, color: j === 0 ? '#0F1423' : '#5A5F6B', textAlign: 'center' }}>{v}</Text>
                            </Box>
                        ))}
                    </Box>
                ))}
            </Box>

            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423', marginTop: 2 }}>交付物二 · 部署视图</Text>
            <Box style={{ flex: 1, background: '#FBFBFC', borderRadius: 4, padding: 14 }}>
                <Box style={{ height: '100%', flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
                    <Box style={{ height: 44, border: '1.5px solid #C9CBD1', borderRadius: 3, flexDirection: 'row', alignItems: 'center', padding: '0 14px', gap: 12 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#5A5F6B', width: 92 }}>生产环境</Text>
                        <Box style={{ flex: 1, height: 22, background: '#FA4F24', borderRadius: 2, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 12, color: '#FFFFFF', textAlign: 'center' }}>核心应用集群 · 双活</Text>
                        </Box>
                    </Box>
                    <Box style={{ height: 44, border: '1.5px solid #C9CBD1', borderRadius: 3, flexDirection: 'row', alignItems: 'center', padding: '0 14px', gap: 12 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#5A5F6B', width: 92 }}>灾备中心</Text>
                        <Box style={{ flex: 1, height: 22, background: '#FBA47A', borderRadius: 2, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 12, color: '#3A1A0A', textAlign: 'center' }}>同城灾备 · 数据实时同步</Text>
                        </Box>
                    </Box>
                    <Box style={{ height: 44, border: '1.5px dashed #C9CBD1', borderRadius: 3, flexDirection: 'row', alignItems: 'center', padding: '0 14px', gap: 12 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#8A8F99', width: 92 }}>测试环境</Text>
                        <Box style={{ flex: 1, height: 22, background: '#F1F2F4', borderRadius: 2, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 12, color: '#5A5F6B', textAlign: 'center' }}>与生产隔离 · 数据脱敏</Text>
                        </Box>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 右 38% 标准规范 */}
        <Box style={{ flex: 38, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423' }}>交付物三 · 技术标准规范</Text>
            {[
                { n: 'S1', t: '技术选型标准', d: '明确各层准入技术清单与禁用清单，选型须走评估流程。' },
                { n: 'S2', t: '接口与集成标准', d: '统一 API 风格、版本策略、鉴权方式与错误码规范。' },
                { n: 'S3', t: '部署与运维标准', d: '环境分层、发布流程、容量阈值与监控告警基线。' },
                { n: 'S4', t: '安全与合规标准', d: '数据分级、访问控制、日志留痕与等保合规要求。' },
            ].map((it, i) => (
                <Box key={i} style={{ height: 98, background: '#F7F7F8', borderRadius: 4, padding: '12px 16px', flexDirection: 'column', borderLeft: '4px solid #FA4F24' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FA4F24' }}>{it.n}</Text>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423', marginTop: 6 }}>{it.t}</Text>
                    <Text style={{ fontSize: 15, color: '#3A4050', marginTop: 6, lineHeight: 1.45 }}>{it.d}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · EA企业架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>24 / 26</Text>
    </Box>
</Slide>
