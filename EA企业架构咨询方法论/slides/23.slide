<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            TA 之方法：以<span style={{ color: '#FA4F24' }}>架构确定性</span>应对技术不确定性
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            技术架构回答「用什么支撑」—— 技术会过时，但分层与标准可以长期稳定
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 左标题栏 + 右四步 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 24 }}>

        {/* 左 32% */}
        <Box style={{
            width: 336, background: 'linear-gradient(160deg, #FA4F24 0%, #F87D2F 100%)',
            borderRadius: 4, padding: 28, flexDirection: 'column', justifyContent: 'space-between',
        }}>
            <Box>
                <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.8)', letterSpacing: 2 }}>TECHNOLOGY ARCHITECTURE</Text>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF', marginTop: 14, lineHeight: 1.25 }}>
                    TA
                    <br />
                    技术架构
                </Text>
            </Box>
            <Box>
                <Box style={{ width: 44, height: 4, background: 'rgba(255,255,255,0.7)' }} />
                <Text style={{ fontSize: 17, color: 'rgba(255,255,255,0.94)', marginTop: 16, lineHeight: 1.55 }}>
                    不在单点技术上押注，而在分层结构与接口标准上投资 —— 让技术换代不推翻业务。
                </Text>
            </Box>
        </Box>

        {/* 右 68% 四步 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423' }}>四步作业法</Text>
            {[
                { n: '01', t: '需求输入', d: '从 AA 的应用组合与 DA 的数据规模反推技术需求：并发、时延、容量、可用性。', k: '技术需求基线' },
                { n: '02', t: '分层设计', d: '按基础设施 / 平台 / 数据 / 集成 / 安全五层划分，明确每层职责与层间接口。', k: '技术分层蓝图' },
                { n: '03', t: '选型评估', d: '对候选技术做成熟度、生态、成本、锁定风险四维评估，给出推荐与理由。', k: '选型评估矩阵' },
                { n: '04', t: '演进路线', d: '把目标态拆为三阶段，标注里程碑与退坡路径，避免一次性大替换。', k: '技术演进路线图' },
            ].map((it, i) => (
                <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', background: '#F7F7F8', borderRadius: 4, padding: '12px 20px', gap: 18, borderLeft: '4px solid #FA4F24' }}>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FA4F24', width: 56 }}>{it.n}</Text>
                    <Box style={{ width: 148 }}>
                        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423' }}>{it.t}</Text>
                    </Box>
                    <Text style={{ fontSize: 16, color: '#3A4050', lineHeight: 1.45, flex: 1 }}>{it.d}</Text>
                    <Box style={{ width: 138, background: 'rgba(250,79,36,0.1)', borderRadius: 3, padding: '6px 8px' }}>
                        <Text style={{ fontSize: 13, color: '#C43A17', textAlign: 'center' }}>{it.k}</Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · EA企业架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>23 / 26</Text>
    </Box>
</Slide>
