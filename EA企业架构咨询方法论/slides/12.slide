<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            BA 之内容：<span style={{ color: '#FA4F24' }}>三类核心交付物</span>与关键要素
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            交付物不是文档堆砌 —— 三类成果分别回答「有哪些能力」「怎么创造价值」「谁来承担」
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 非对称双栏 62:38 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 28 }}>

        {/* 左 62% 交付物 */}
        <Box style={{ flex: 62, flexDirection: 'column', gap: 12 }}>
            {[
                { n: '①', t: '业务能力地图', d: '按「能力域 → 能力组 → 能力项」三层分解，形成可管理的企业能力全景。', els: '能力域 / 能力项 / 成熟度 / 战略重要度' },
                { n: '②', t: '价值流图', d: '描述端到端价值创造的阶段、参与角色与关键交付，识别断点与冗余。', els: '价值阶段 / 触发事件 / 交付物 / 周期' },
                { n: '③', t: '组织映射表', d: '把能力与组织单元、岗位对齐，明确能力责任主体与协同关系。', els: '能力 / 责任部门 / 岗位 / 协同方' },
            ].map((it, i) => (
                <Box key={i} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '18px 24px', flexDirection: 'column', borderTop: '4px solid #FA4F24' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FA4F24' }}>{it.n}</Text>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F1423' }}>{it.t}</Text>
                    </Box>
                    <Text style={{ fontSize: 17, color: '#3A4050', marginTop: 10, lineHeight: 1.5 }}>{it.d}</Text>
                    <Box style={{ marginTop: 'auto', background: 'rgba(250,79,36,0.08)', borderRadius: 3, padding: '7px 12px' }}>
                        <Text style={{ fontSize: 15, color: '#C43A17' }}>关键要素：{it.els}</Text>
                    </Box>
                </Box>
            ))}
        </Box>

        {/* 右 38% 能力地图示意 */}
        <Box style={{ flex: 38, flexDirection: 'column' }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F1423', marginBottom: 12 }}>
                能力地图结构示意
            </Text>
            <Box style={{ flexDirection: 'column', gap: 8 }}>
                <Box style={{ height: 40, background: '#FA4F24', borderRadius: 3, justifyContent: 'center', paddingLeft: 14 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>L1 · 能力域（研发 / 供应 / 销售）</Text>
                </Box>
                <Box style={{ height: 74, flexDirection: 'row', gap: 8 }}>
                    {[
                        { t: '能力组 A', bg: '#F87D2F', c: '#FFFFFF' },
                        { t: '能力组 B', bg: '#FBA47A', c: '#3A1A0A' },
                        { t: '能力组 C', bg: '#FDD5BE', c: '#3A1A0A' },
                    ].map((it, i) => (
                        <Box key={i} style={{ flex: 1, background: it.bg, borderRadius: 3, justifyContent: 'center', alignItems: 'center', padding: 6 }}>
                            <Text style={{ fontSize: 15, fontWeight: 'bold', color: it.c, textAlign: 'center' }}>{it.t}</Text>
                        </Box>
                    ))}
                </Box>
                {['能力项 · 成熟度 3.5', '能力项 · 成熟度 2.0（短板）', '能力项 · 成熟度 4.0', '能力项 · 待建设（缺口）'].map((t, i) => (
                    <Box key={i} style={{ height: 30, background: '#F1F2F4', borderRadius: 3, justifyContent: 'center', paddingLeft: 14 }}>
                        <Text style={{ fontSize: 14, color: '#3A4050' }}>{t}</Text>
                    </Box>
                ))}
            </Box>
            <Box style={{ marginTop: 12, background: 'rgba(250,79,36,0.08)', borderLeft: '4px solid #FA4F24', borderRadius: 3, padding: '12px 16px' }}>
                <Text style={{ fontSize: 16, color: '#0F1423', lineHeight: 1.5 }}>
                    <span style={{ fontWeight: 'bold', color: '#FA4F24' }}>判断：</span>
                    成熟度低 ≠ 优先级高 —— 须叠加战略重要度，才能定投资次序。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · EA企业架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>12 / 26</Text>
    </Box>
</Slide>
