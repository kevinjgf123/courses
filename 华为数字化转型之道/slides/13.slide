<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            成熟度评估怎么用：<span style={{ color: '#FA4F24' }}>自检 → 短板 → 纳入后续规划</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            华为的建议节奏是：前期先自检部分问题摸个底，转型推进一段后再做完整评估——不是一次性交作业
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 16, paddingBottom: 12, height: 479, flexDirection: 'column', gap: 10 }}>

        {/* 四步流程 */}
        <Box style={{ height: 168, flexDirection: 'row', alignItems: 'stretch', gap: 0 }}>
            {[
                { n: '①', t: '前期自检', d: '选模型中部分问题快速自检，快速了解当前水平', c: '#FA4F24', o: '快速成熟度自检表' },
                { n: '②', t: '关键用户访谈', d: '面对面访谈，同步收集关键需求与转型期望', c: '#E0641E', o: '访谈纪要 + 打分表' },
                { n: '③', t: '识别关键短板', d: '定位制约当前级别跃升的关键短板，不追求全面铺开', c: '#D2531A', o: '短板清单与优先级' },
                { n: '④', t: '完整评估复评', d: '转型推进一段后做完整评估，检验成果并再校准', c: '#C43A17', o: '成熟度评估报告' },
            ].map((x, i) => (
                <Box key={x.n} style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch' }}>
                    <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '13px 15px', flexDirection: 'column' }}>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: x.c }}>{x.n}</Text>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1423', marginTop: 6 }}>{x.t}</Text>
                        <Text style={{ fontSize: 12, color: '#3A4050', lineHeight: 1.45, marginTop: 7, flex: 1 }}>{x.d}</Text>
                        <Text style={{ fontSize: 11, color: '#C43A17' }}>产出：{x.o}</Text>
                    </Box>
                    {i < 3 && (
                        <Box style={{ width: 24, alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FBA15C' }}>→</Text>
                        </Box>
                    )}
                </Box>
            ))}
        </Box>

        {/* 纳入规划的落点 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 10 }}>
            <Box style={{ flex: 1, background: '#0F1423', borderRadius: 4, padding: '16px 20px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FBA15C' }}>评估结论落到三阶的哪一步</Text>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 7, marginTop: 12 }}>
                    {[
                        { s: '第一阶', d: '短板 → 愿景中要解决什么 → 描绘成什么样', c: '#FA4F24' },
                        { s: '第二阶', d: '短板 → 架构哪个域要补 → 找到突破口', c: '#E0641E' },
                        { s: '第三阶', d: '短板 → 变成哪条举措 → 进哪期路标', c: '#C43A17' },
                    ].map((x) => (
                        <Box key={x.s} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', background: 'rgba(255,255,255,0.06)', borderLeft: '3px solid ' + x.c, borderRadius: 2, padding: '0 12px', gap: 10 }}>
                            <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: x.c, width: 56 }}>{x.s}</Text>
                            <Text style={{ fontSize: 12.5, color: 'rgba(255,255,255,0.88)' }}>{x.d}</Text>
                        </Box>
                    ))}
                </Box>
            </Box>
            <Box style={{ width: 468, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '16px 20px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C43A17' }}>现场最常见的三种误用</Text>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 8, marginTop: 12 }}>
                    {[
                        { k: '当成打分比赛', v: '各部门报高分以证明自己重要，结果短板被掩盖' },
                        { k: '当成一次性交差', v: '评完就归档，没人拿它去定举措和排路标' },
                        { k: '只评技术不评业务', v: '系统上线率很高，但客户体验一点没变' },
                    ].map((x) => (
                        <Box key={x.k} style={{ flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423' }}>{x.k}</Text>
                            <Text style={{ fontSize: 11.5, color: '#5A6070', lineHeight: 1.35, marginTop: 3 }}>{x.v}</Text>
                        </Box>
                    ))}
                </Box>
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 华为数字化转型之道</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>13 / 35</Text>
    </Box>
</Slide>