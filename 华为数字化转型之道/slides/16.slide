<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            步骤 1–2：<span style={{ color: '#FA4F24' }}>战略解码</span>与 5「看」
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            业务战略是数字化转型的龙头——不先解码战略，五看看到的就只是现象，不是机会
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 14, paddingBottom: 12, height: 479, flexDirection: 'column', gap: 9 }}>

        {/* 上：步骤1 */}
        <Box style={{ height: 116, flexDirection: 'row', gap: 10 }}>
            <Box style={{ width: 74, background: '#FA4F24', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '12px 18px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423' }}>理解企业的战略诉求</Text>
                <Text style={{ fontSize: 13, color: '#3A4050', lineHeight: 1.45, marginTop: 8 }}>进行业务高层访谈，获取他们对业务战略和目标的描述，以及对数字化转型的期望</Text>
            </Box>
            <Box style={{ width: 452, background: '#FFF3EE', borderRadius: 3, borderLeft: '4px solid #FBA15C', padding: '12px 18px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#C43A17' }}>进行业务战略解码</Text>
                <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.45, marginTop: 6 }}>
                    识别战略关注要点并做专项分析：如何用数字技术支撑战略目标达成、如何用数字技术构建核心竞争力
                </Text>
            </Box>
        </Box>

        {/* 中：5 看 */}
        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
                <Box style={{ width: 74, height: 28, background: '#FA4F24', borderRadius: 3, flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
                </Box>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1423' }}>5「看」</Text>
                <Text style={{ fontSize: 13, color: '#8A8F99' }}>五看的顺序不是随意的：从战略往内看到技术，最后回到自己该做什么</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 8 }}>
                {[
                    { n: '看战略', d: '业务战略诉求', q: '战略里哪几条必须靠数字技术才能实现', c: '#FA4F24' },
                    { n: '看客户', d: '客户体验需求的变化', q: '客户的期待在哪一年跨过现有能力', c: '#E0641E' },
                    { n: '看行业', d: '行业趋势', q: '同行做到什么程度，不做会掉队到什么位置', c: '#D2531A' },
                    { n: '看自己', d: '业务模式的变化', q: '我们自己的模式哪一环最该重构', c: '#C43A17' },
                    { n: '看技术', d: '技术融入业务的场景与标杆', q: '哪个技术现在能真正改变这件事', c: '#9E3410' },
                ].map((x, i) => (
                    <Box key={x.n} style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, borderTop: '3px solid ' + x.c, padding: '12px 13px', flexDirection: 'column' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: x.c }}>{x.n}</Text>
                        <Text style={{ fontSize: 12, color: '#0F1423', marginTop: 7, lineHeight: 1.35 }}>{x.d}</Text>
                        <Box style={{ flex: 1, marginTop: 9, background: '#FFFFFF', borderRadius: 2, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                            <Text style={{ fontSize: 11, color: '#5A6070', lineHeight: 1.4 }}>{x.q}</Text>
                        </Box>
                        <Text style={{ fontSize: 10.5, color: '#8A8F99', marginTop: 8 }}>第 {i + 1} 看</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 底部 */}
        <Box style={{ height: 44, background: '#0F1423', borderRadius: 3, flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 16 }}>
            <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#FBA15C', width: 130 }}>这一段的产出</Text>
            <Text style={{ fontSize: 14, color: '#FFFFFF', flex: 1 }}>战略关注要点清单 · 五看扫描记录 · <tspan style={{ color: '#FA4F24' }}>数字化机会与价值清单</tspan></Text>
            <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.7)' }}>机会清单直接流向步骤 5的愿景</Text>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 华为数字化转型之道</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>16 / 35</Text>
    </Box>
</Slide>