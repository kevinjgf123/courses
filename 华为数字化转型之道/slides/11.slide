<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            成熟度评估：<span style={{ color: '#FA4F24' }}>四大主题 · 18 个问题</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            不是发问卷打分，是靠关键业务用户面对面访谈现场评估——回答问题的过程本身就是诊断过程
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 16, paddingBottom: 12, height: 479, flexDirection: 'column', gap: 10 }}>

        {/* 四主题 */}
        <Box style={{ height: 296, flexDirection: 'row', gap: 9 }}>
            {[
                {
                    n: '战略决心', q: 'Q1–6', c: '#FA4F24',
                    d: '转型是否以业务战略为牵引，顶层设计是否有蓝图、举措与路标',
                    items: ['是否以业务战略为牵引', '有没有清晰愿景', '高层对机遇与威胁的认知深度', '是否绘制了架构蓝图', '是否定义全局性工作', '预算与投人是否到位'],
                },
                {
                    n: '业务重构', q: 'Q7–10', c: '#E0641E',
                    d: '为实现核心业务，业务在转型前后到底改变了什么',
                    items: ['客户体验是否重构', '作业模式是否重构', '运营模式是否重构', '是否提供数字产品与服务'],
                },
                {
                    n: '数字能力', q: 'Q11–15', c: '#D2531A',
                    d: '有没有技术领导力，能不能承载前两类的重构',
                    items: ['应用现代化程度', '数据治理与分析能力', 'AI 使能水平', '资源与连接', '安全与隐私保护'],
                },
                {
                    n: '转型保障', q: 'Q16–18', c: '#C43A17',
                    d: '推进过程中组织、人才与变革管理的支撑是否充分',
                    items: ['变革管理机制', '数字化人才密度', '组织保障是否落实'],
                },
            ].map((x) => (
                <Box key={x.n} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 14px', flexDirection: 'column' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 10 }}>
                        <Box style={{ width: 24, height: 24, background: x.c, borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#FFFFFF' }}>{x.q[1]}</Text>
                        </Box>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423', flex: 1 }}>{x.n}</Text>
                    </Box>
                    <Text style={{ fontSize: 11.5, color: '#5A6070', lineHeight: 1.4, marginTop: 9, marginBottom: 9 }}>{x.d}</Text>
                    <Box style={{ flex: 1, flexDirection: 'column' }}>
                        {x.items.map((y, i) => (
                            <Box key={y} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 6, marginTop: i === 0 ? 0 : 7 }}>
                                <Text style={{ fontSize: 10.5, color: x.c, fontWeight: 'bold' }}>□</Text>
                                <Text style={{ fontSize: 11.5, color: '#3A4050', lineHeight: 1.35, flex: 1 }}>{y}</Text>
                            </Box>
                        ))}
                    </Box>
                </Box>
            ))}
        </Box>

        {/* 底部：三种打分法 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
            <Box style={{ height: 42, background: '#0F1423', borderRadius: 3, flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 16 }}>
                <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#FBA15C', width: 168 }}>三种评估方式（可组合）</Text>
                <Text style={{ fontSize: 14, color: '#FFFFFF', flex: 1 }}>面对面访谈（最有效）· 填写问卷 · 线上调查</Text>
                <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.7)' }}>华为原书原话：访谈中同时收集业务的关键需求</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 9 }}>
                {[
                    { k: '咨询业扩展版（5 维 196 项）', v: '华为供应链在四主题之外增加「价值目标」，共 5 维度 196 个评估项，用于与上下游伙伴横向比较' },
                    { k: '运营商版（5 维 5阶）', v: '转型战略 / 价值度量 / 流程优化 / 数据与平台 / 组织人才，按 L1–L5 评估，配套场景闭环迭代' },
                ].map((x) => (
                    <Box key={x.k} style={{ flex: 1, background: '#FFF3EE', borderRadius: 3, borderLeft: '4px solid #FBA15C', padding: '0 16px', flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#C43A17' }}>{x.k}</Text>
                        <Text style={{ fontSize: 12, color: '#3A4050', lineHeight: 1.4, marginTop: 5 }}>{x.v}</Text>
                    </Box>
                ))}
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 华为数字化转型之道</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>11 / 35</Text>
    </Box>
</Slide>