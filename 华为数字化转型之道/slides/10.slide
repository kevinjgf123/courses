<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            三个平台能力：<span style={{ color: '#FA4F24' }}>不统一建，场景里的东西必然重来一遍</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            原书平台篇第11–13 章——这是前面八本分域专册共同的落脚处，不是三件额外的工作
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 16, paddingBottom: 12, height: 479, flexDirection: 'column', gap: 10 }}>

        {/* 三个平台横条 */}
        <Box style={{ height: 250, flexDirection: 'column', gap: 7 }}>
            {[
                {
                    n: '11', t: '统一数据底座', c: '#FA4F24',
                    d: '统一标准与模型，数据一次建成、全域可用',
                    pts: ['数据资产目录：主题域→业务对象→逻辑实体→属性', '湖仓一体：统一存储、分级授权、多场景复用'],
                    tag: '对应：DA / 治理 / 主数据 / 指标',
                },
                {
                    n: '12', t: '云化数字平台', c: '#E0641E',
                    d: '统一算力与技术底座，支撑快速迭代与弹性扩展',
                    pts: ['基础设施层 / 数字平台层 / 公共服务层三横', '安全保障与运营维护两纵贯穿'],
                    tag: '对应：TA / 管道处理',
                },
                {
                    n: '13', t: '变革治理体系', c: '#C43A17',
                    d: '决策到复盘的闭环，不靠个人热情撑着',
                    pts: ['变革指导委员会 + 领域与项目组两级责任', '架构管控：立法 / 嵌入流程 / 合规审计'],
                    tag: '对应：FDE / BA',
                },
            ].map((x) => (
                <Box key={x.n} style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', gap: 10 }}>
                    <Box style={{ width: 54, background: x.c, borderRadius: 3, alignItems: 'center', justifyContent: 'center', flexDirection: 'column' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>{x.n}</Text>
                        <Text style={{ fontSize: 9.5, color: 'rgba(255,255,255,0.85)', marginTop: 2 }}>章</Text>
                    </Box>
                    <Box style={{ width: 206, background: '#F7F7F8', borderRadius: 3, padding: '0 14px', flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423' }}>{x.t}</Text>
                        <Text style={{ fontSize: 11, color: '#C43A17', marginTop: 6, lineHeight: 1.35 }}>{x.tag}</Text>
                    </Box>
                    <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '0 15px', flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.35, marginBottom: 7 }}>{x.d}</Text>
                        {x.pts.map((p, i) => (
                            <Box key={p} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 6, marginTop: i === 0 ? 0 : 6 }}>
                                <Text style={{ fontSize: 10.5, color: x.c, fontWeight: 'bold' }}>▪</Text>
                                <Text style={{ fontSize: 11.5, color: '#5A6070', lineHeight: 1.3, flex: 1 }}>{p}</Text>
                            </Box>
                        ))}
                    </Box>
                </Box>
            ))}
        </Box>

        {/* 底部结论 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 9 }}>
            <Box style={{ flex: 1, background: '#0F1423', borderRadius: 3, padding: '0 20px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FBA15C' }}>为什么这三个必须统一建</Text>
                <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.88)', lineHeight: 1.45, marginTop: 7 }}>
                    场景各自建底座，第一年省事、第三年全部重来——三个平台是把重复劳动从项目里拿出去的唯一位置
                </Text>
            </Box>
            <Box style={{ width: 396, background: '#FFF3EE', borderRadius: 3, borderLeft: '4px solid #FA4F24', padding: '0 18px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#C43A17' }}>咨询落点</Text>
                <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.45, marginTop: 6 }}>
                    每个分域专册的产出物，最终都要归到这三个平台之一；归不进去的，说明它不是平台能力，是项目定制
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 华为数字化转型之道</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>10 / 35</Text>
    </Box>
</Slide>