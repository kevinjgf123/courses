<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
之内容：<span style={{ color: '#FA4F24' }}>能力地图绘制与四类缺口识别</span>
        </Text>
      <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
   能力地图不是一张漂亮的大图，它的作用是让四类缺口自己暴露出来
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 13 }}>

     {/* 四类缺口 */}
     <Box style={{ flex: 1, flexDirection: 'column', gap: 9 }}>
    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423' }}>四类缺口及其处置方式</Text>
        {[
          { n: '01', t: '能力空缺', d: '战略要求这项能力，但企业现在完全没有', ex: '例：要求具备全球供应链统筹能力，实际分散在各事业部', c: '#FA4F24', act: '建（Build）' },
        { n: '02', t: '能力重复', d: '多个组织各自建了同一项能力，没有规模效应', ex: '例：三个事业部各建一套供应商管理系统', c: '#F8622F', act: '合（Merge）' },
    { n: '03', t: '能力错配', d: '能力本身有价值，但放错了位置，不产生战略价值', ex: '例：把核心竞争力建在非战略重心业务上', c: '#FBA15C', act: '挪（Move）' },
      { n: '04', t: '能力虚胖', d: '名称听起来很强，实际成熟度只有 L1–L2', ex: '例：「智能制造能力」实际只有数据采集', c: '#FDC69A', act: '实（Substantiate）' },
        ].map((it, i) => (
         <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', background: '#F7F7F8', borderRadius: 4, padding: '0 20px', gap: 14, borderLeft: `4px solid ${it.c}` }}>
       <Text style={{ fontSize: 24, fontWeight: 'bold', color: it.c, width: 40 }}>{it.n}</Text>
     <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423', width: 96 }}>{it.t}</Text>
   <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 14, color: '#3A4050', lineHeight: 1.4 }}>{it.d}</Text>
      <Text style={{ fontSize: 12, color: '#B8BDC7', marginTop: 3 }}>{it.ex}</Text>
       </Box>
    <Box style={{ width: 122, background: it.c, borderRadius: 3, padding: '7px 0', alignItems: 'center' }}>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: it.c === '#FDC69A' ? '#3A2000' : '#FFFFFF' }}>{it.act}</Text>
        </Box>
          </Box>
     ))}
 </Box>

        {/* 地图的两种呈现 */}
      <Box style={{ height: 138, flexDirection: 'row', gap: 14 }}>
    <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '14px 20px', borderLeft: '4px solid #FA4F24', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423' }}>域级热力图（汇报用）</Text>
     <Text style={{ fontSize: 14, color: '#3A4050', lineHeight: 1.55, marginTop: 7 }}>
    一页纸讲清「我们在哪、长板在哪、短板在哪」。
        适合向管理层汇报，但看不出具体能力项，因此必须配一份明细清单。
   </Text>
            </Box>
  <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '14px 20px', borderLeft: '4px solid #F87D2F', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423' }}>能力项明细表（执行用）</Text>
      <Text style={{ fontSize: 14, color: '#3A4050', lineHeight: 1.55, marginTop: 7 }}>
      逐项列能力编号、成熟度、重要度、Owner、所属举措。
     这是路线图和考核的直接输入——汇报用的图不能替代它。
    </Text>
       </Box>
       </Box>
    </Box>

    {/* C 区 */}
  <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
 <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
     <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
       <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · BA业务架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>22 / 30</Text>
    </Box>
</Slide>