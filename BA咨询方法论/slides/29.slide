<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
常见误区：<span style={{ color: '#FA4F24' }}>五个把业务架构做砸的做法</span>
     </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
    这五条不是理论推演，是我们见过频率最高的翻车方式——每条都给出代价判断
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 12 }}>

      {[
   { n: '01', t: '从组织架构图改名叫「能力地图」', d: '把部门框改成能力框，内容完全不变。组织一调整，架构就作废。', cost: '架构无沉淀，两年必重来', c: '#FA4F24' },
        { n: '02', t: '能力名称后面挂括号写部门', d: '「合同管理（法务部）」这类写法，本质仍是组织视角，只是套了个壳。', cost: '解耦失败，数据架构接不上', c: '#F8622F' },
    { n: '03', t: '把活动当成能力', d: '「组织会议」「填写报表」写进能力清单。全量膨胀到几百项，无法排优先级。', cost: '评估失效，路线图排不出来', c: '#FBA15C' },
    { n: '04', t: '成熟度靠拍脑袋给分', d: '没有证据就报 L4。结果是整张热力图一片橙，管理层看完不再相信。', cost: '失去信任，第二年无人配合', c: '#FDC69A', tc: '#3A2000' },
   { n: '05', t: '架构交付完就结束', d: '没有运营机制、没有考核挂钩、没有 Owner。半年后成熟度评分几乎没动。', cost: '投入沉没，架构沦为历史资料', c: '#FBA15C' },
     ].map((it, i) => (
      <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', background: '#F7F7F8', borderRadius: 4, padding: '0 22px', gap: 18, borderLeft: `4px solid ${it.c}` }}>
   <Text style={{ fontSize: 30, fontWeight: 'bold', color: it.c, width: 46 }}>{it.n}</Text>
    <Box style={{ width: 330 }}>
     <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F1423', lineHeight: 1.3 }}>{it.t}</Text>
     </Box>
     <Text style={{ fontSize: 15, color: '#3A4050', lineHeight: 1.45, flex: 1 }}>{it.d}</Text>
        <Box style={{ width: 246, background: 'rgba(250,79,36,0.1)', borderRadius: 3, padding: '9px 12px' }}>
    <Text style={{ fontSize: 11, color: '#8A8F99' }}>代价</Text>
   <Text style={{ fontSize: 13, color: '#C43A17', fontWeight: 'bold', marginTop: 3 }}>{it.cost}</Text>
         </Box>
     </Box>
      ))}

      <Box style={{ height: 58, background: 'linear-gradient(160deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '0 24px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>共同的根因</Text>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.95)', lineHeight: 1.5, flex: 1 }}>
      五个坑本质是同一件事：<Text style={{ fontWeight: 'bold' }}>把业务架构当成一次性的文档，而不是一套要长期活着的数据</Text>。数据必须有 Owner、有字段、有更新机制——架构同理
        </Text>
      </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
     <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
     <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · BA业务架构咨询方法论</Text>
        </Box>
   <Text style={{ fontSize: 14, color: '#8A8F99' }}>29 / 30</Text>
    </Box>
</Slide>