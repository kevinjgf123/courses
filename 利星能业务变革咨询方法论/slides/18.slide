<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            技术现状分析框架 <span style={{ color: '#FA4F24' }}>含 AI 所需技术</span>
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            招标 3.2(4) 要求含 AI 所需技术——这一项不写在诊断里，阶段二就无从落地
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>
        {/* 上：基础设施四层 */}
        <Box style={{ height: 26, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 4, height: 16, background: '#3A4050' }} />
            <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0F1423' }}>基础设施四层现状（传统技术侧）</Text>
            <Text style={{ fontSize: 11, color: '#8A8F99' }}>算力与存储 · 网络 · 运行环境 · 安全合规</Text>
        </Box>
        <Box style={{ height: 76, flexDirection: 'row', gap: 7 }}>
            {[
                { t: '算力与存储', v: '本地机房 / 云上资源，GPU 是否已有，存储容量与增速' },
                { t: '网络', v: '总部—电站—工厂链路，带宽与时延，异地访问是否受限' },
                { t: '运行环境', v: '虚拟化/容器化程度，中间件版本，运维自动化程度' },
                { t: '安全合规', v: '等保与密级要求，数据出域限制，第三方接入审批链路' },
            ].map((x) => (
                <Box key={x.t} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderTop: '3px solid #5A6070', padding: '10px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423' }}>{x.t}</Text>
                    <Text style={{ fontSize: 10.5, color: '#5A6070', lineHeight: 1.35, marginTop: 4 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>

        {/* 中：AI 五项就绪度 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
            <Box style={{ height: 26, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                <Box style={{ width: 4, height: 16, background: '#FA4F24' }} />
                <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0F1423' }}>AI 所需技术五项就绪度（每项给「有 / 半有 / 无 + 差距说明」）</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 5 }}>
                {[
                    { t: '推理算力', d: 'GPU 资源是否可稳定供给给推理任务；电力行业还需考虑厂区侧可用性与数据不出域要求', lvl: '半有 · 需明确专属配额与调度规则', c: '#FA4F24' },
                    { t: '模型服务', d: '大模型或领域模型的服务化部署能力；本地部署还是外部 API，商务与合规是否已通', lvl: '无 · 需在蓝图层定部署形态', c: '#E0641E' },
                    { t: '向量与检索', d: '文档与知识的切片、向量化、检索能力；这是知识库类场景的前置条件', lvl: '半有 · 需评估切片工艺与密级继承', c: '#D2531A' },
                    { t: '智能体编排', d: '工具白名单、调用编排、状态与记忆管理、人工干预点；决定智能体能不能上线', lvl: '无 · 属应用架构范畴', c: '#C43A17' },
                    { t: '数据与治理配套', d: '数据权限、血缘、日志、评测集；AI 出错时能不能追责，靠这一项兜底', lvl: '半有 · 权限与日志最薄弱', c: '#9E3410' },
                ].map((x) => (
                    <Box key={x.t} style={{ flex: 1, flexDirection: 'row', gap: 10, alignItems: 'stretch', background: '#F7F7F8', borderRadius: 4, borderLeft: '4px solid ' + x.c }}>
                        <Box style={{ width: 116, justifyContent: 'center', flexDirection: 'column', paddingLeft: '12px' }}>
                            <Text style={{ fontSize: 13, fontWeight: 'bold', color: x.c }}>{x.t}</Text>
                        </Box>
                        <Box style={{ flex: 1, justifyContent: 'center', flexDirection: 'column' }}>
                            <Text style={{ fontSize: 10.5, color: '#3A4050', lineHeight: 1.35 }}>{x.d}</Text>
                        </Box>
                        <Box style={{ width: 250, background: '#FFF3EE', borderRadius: 3, padding: '0 11px', flexDirection: 'column', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 10.5, color: '#C43A17', fontWeight: 'bold', lineHeight: 1.3 }}>{x.lvl}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 下 */}
        <Box style={{ height: 44, flexDirection: 'row', gap: 7 }}>
            {[
                { k: '技术结论只写差距', v: '不堆技术名词，写「哪一项缺什么、缺了会挡住哪个场景」', c: '#FA4F24', dark: true },
                { k: 'AI 就绪度绑定场景', v: '每项就绪度都挂到具体 AI 场景上，避免变成与技术无关的清单', c: '#E0641E', dark: false },
                { k: '合规先于能力', v: '数据出域与密级限制是硬约束，模型再强也不能突破，评估时先划边界', c: '#C43A17', dark: false },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: x.dark ? '#0F1423' : '#F7F7F8', borderLeft: '4px solid ' + x.c, borderRadius: 3, padding: '0 13px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: x.dark ? '#FBA15C' : '#0F1423' }}>{x.k}</Text>
                    <Text style={{ fontSize: 10, color: x.dark ? 'rgba(255,255,255,0.86)' : '#5A6070', lineHeight: 1.3, marginTop: 2 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>18 / 36</Text>
    </Box>
</Slide>
