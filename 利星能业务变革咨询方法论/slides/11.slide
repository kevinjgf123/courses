<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            相对通用册，<span style={{ color: '#FA4F24' }}>改了哪六处</span>
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            每处改动都对应招标里的一条硬要求，不是为了好看才改的
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>

        {/* 六处改动：2 列 × 3 行 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 7 }}>
            {[
                [
                    { n: '改 1', t: '颗粒度从「分层分级」改到逐条可勾', f: '通用：BA 到分层分级', t2: '本项目：BA 到 L4 子流程，阶段三到 L5-L6；DA 到业务逻辑实体再到属性；AA 到功能模块再到服务/特性/子特性', c: '#FA4F24' },
                    { n: '改 2', t: '业务域从泛行业改到九个业务块', f: '通用：以制造/零售为例', t2: '本项目：E1–E5 能源链 + S1/S2 储能链 + 指标体系横切，每块单独出流程形态与 AI 落点', c: '#FA4F24' },
                    { n: '改 3', t: '组织从泛指部门改到九个实名部门', f: '通用：访谈业务与技术口', t2: '本项目：九个部门各自有必问三件事，访谈提纲按部门分册，不发通用问卷', c: '#E0641E' },
                ],
                [
                    { n: '改 4', t: '可追溯从「有关联」改到编号一一对应', f: '通用：说明四层之间的关系', t2: '本项目：PAIN/ROOT/BLD/REQ 四段编号，空号即作废，需求可反向三分钟倒推回痛点', c: '#C43A17' },
                    { n: '改 5', t: 'AI 从一种实现改为独立成节两轮作业', f: '通用：AI 不在方法论主体内', t2: '本项目：阶段二出初识清单与优先级排序，阶段三出场景详细设计（目标/输入/知识来源/智能体边界/评估指标）', c: '#C43A17' },
                    { n: '改 6', t: '交付从方法论自然产出改为九项合同清单', f: '通用：按方法论自然沉淀成果', t2: '本项目：九项交付物逐项绑定阶段、责任人与验收要点，评审时按清单逐行签收', c: '#9E3410' },
                ],
            ].map((row, ri) => (
                <Box key={ri} style={{ flex: 1, flexDirection: 'row', gap: 7 }}>
                    {row.map((x) => (
                        <Box key={x.n} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderLeft: '4px solid ' + x.c, padding: '11px 14px', flexDirection: 'column' }}>
                            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 7 }}>
                                <Box style={{ height: 18, padding: '0 6px', borderRadius: 2, background: x.c, alignItems: 'center', justifyContent: 'center', flexDirection: 'row' }}>
                                    <Text style={{ fontSize: 10, fontWeight: 'bold', color: '#FFFFFF' }}>{x.n}</Text>
                                </Box>
                                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F1423', flex: 1 }}>{x.t}</Text>
                            </Box>
                            <Text style={{ fontSize: 10.5, color: '#8A8F99', lineHeight: 1.3, marginTop: 6 }}>{x.f}</Text>
                            <Text style={{ fontSize: 11, color: '#3A4050', lineHeight: 1.4, marginTop: 3, flex: 1 }}>{x.t2}</Text>
                        </Box>
                    ))}
                </Box>
            ))}
        </Box>

        {/* 底部 */}
        <Box style={{ height: 54, background: '#0F1423', borderRadius: 4, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FBA15C', width: 176 }}>六处改动的共同点</Text>
            <Text style={{ fontSize: 14, color: '#FFFFFF', flex: 1, lineHeight: 1.5 }}>
                没有一处改动是为了「显得更专业」，全部是为了在评审现场<span style={{ color: '#FBA15C' }}>能指着这一行说「我们就是这么做的」</span>，并且交得出对应的产出物
            </Text>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>11 / 36</Text>
    </Box>
</Slide>
