<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            数据下探：<span style={{ color: '#FA4F24' }}>逻辑实体属性 + 指标字典</span>
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            招标 3.3.3(2) + 交付物⑤⑧：属性设计要同时向上向下拉通，指标字典是唯一出口
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>
        {/* 上：实体属性表 */}
        <Box style={{ height: 22, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 4, height: 16, background: '#FA4F24' }} />
            <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0F1423' }}>逻辑实体属性设计示例：实体「电站」</Text>
        </Box>
        <Box style={{ height: 22, flexDirection: 'row', gap: 5 }}>
            {['属性名', '业务定义', '数据类型', '取值域/枚举', '主键/外键', '数据标准', '代码标准', '密级'].map((h, i) => (
                <Box key={h} style={{ flex: i === 1 ? 2.2 : 1, background: '#0F1423', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10.5, fontWeight: 'bold', color: '#FFFFFF' }}>{h}</Text>
                </Box>
            ))}
        </Box>
        {[
            { a: 'station_id', d: '电站唯一标识，跨系统一致', t: '字符', e: 'ST + 区域码(2) + 序列(4)', k: '主键', s: 'GB/T 电站编码规则', c: '内部编码规范 V2', m: '内部' },
            { a: 'station_name', d: '电站名称，与资产台账一致', t: '字符', e: '—', k: '—', s: '命名规范：区域+类型+序号', c: '—', m: '内部' },
            { a: 'owner_org_id', d: '当前运营责任组织', t: '字符', e: '引用组织主数据编码', k: '外键', s: '组织编码标准', c: '统一社会信用代码', m: '内部' },
            { a: 'capacity_mw', d: '装机容量，设计口径', t: '数值', e: '> 0，单位 MW', k: '—', s: '容量口径：铭牌容量/并网容量二选一', c: '—', m: '内部' },
            { a: 'grid_point_id', d: '并网点标识，交易结算关联键', t: '字符', e: '引用电网编码', k: '外键', s: '并网点编码标准', c: '电网公司编码', m: '敏感' },
            { a: 'asset_status', d: '资产状态，用于运维与财务对齐', t: '枚举', e: '在建/试运/在运/退役/处置', k: '—', s: '资产状态代码标准', c: '公司资产分类代码', m: '内部' },
        ].map((r) => (
            <Box key={r.a} style={{ flex: 1, flexDirection: 'row', gap: 5 }}>
                <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10.5, color: '#0F1423', fontWeight: 'bold' }}>{r.a}</Text>
                </Box>
                <Box style={{ flex: 2.2, background: '#F7F7F8', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10, color: '#3A4050', lineHeight: 1.25 }}>{r.d}</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10, color: '#5A6070' }}>{r.t}</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10, color: '#5A6070', lineHeight: 1.25 }}>{r.e}</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10, color: '#5A6070' }}>{r.k}</Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10, color: '#C43A17', lineHeight: 1.25 }}>{r.s}</Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10, color: '#C43A17', lineHeight: 1.25 }}>{r.c}</Text>
                </Box>
                <Box style={{ flex: 1, background: r.m === '敏感' ? '#FA4F24' : '#F7F7F8', borderRadius: 3, padding: '0 9px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 10, color: r.m === '敏感' ? '#FFFFFF' : '#5A6070' }}>{r.m}</Text>
                </Box>
            </Box>
        ))}

        {/* 中：双向拉通 */}
        <Box style={{ height: 30, flexDirection: 'row', gap: 8, alignItems: 'stretch' }}>
            <Box style={{ flex: 1, background: '#0F1423', borderRadius: 3, padding: '0 14px', flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FBA15C', width: 92 }}>向上拉通 BA</Text>
                <Text style={{ fontSize: 10.5, color: 'rgba(255,255,255,0.88)', flex: 1, lineHeight: 1.3 }}>
                    每个实体标注服务哪几条 L4；每条 L4 标注需要哪些实体与属性——这条链断了，L4 就跑不通
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#0F1423', borderRadius: 3, padding: '0 14px', flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FBA15C', width: 92 }}>向下拉通 AA</Text>
                <Text style={{ fontSize: 10.5, color: 'rgba(255,255,255,0.88)', flex: 1, lineHeight: 1.3 }}>
                    每个实体标注落点系统、数据流向与同步方式——这条链断了，集成架构就是空的
                </Text>
            </Box>
        </Box>

        {/* 下：指标字典八要素 + 考核数据清单 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 8, alignItems: 'stretch' }}>
            <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '11px 14px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#C43A17' }}>交付物⑧《指标字典》八要素（缺一项不进字典）</Text>
                <Text style={{ fontSize: 11, color: '#3A4050', lineHeight: 1.5, marginTop: 6 }}>
                    指标名称与编码 · 业务定义 · 计算公式 · 计量单位 · 统计周期 · 数据来源与取数口径 · 业务与数据责任人 · 有效期与使用场景
                </Text>
                <Text style={{ fontSize: 10.5, color: '#C43A17', lineHeight: 1.35, marginTop: 6 }}>
                    判据：口径没定下来、责任人没落实的指标，不进字典只进待办清单——宁可少几个，不能有错的口径。
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderLeft: '4px solid #C43A17', padding: '11px 14px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#3A4050' }}>交付物⑨《绩效考核所需业务数据清单》</Text>
                <Text style={{ fontSize: 11, color: '#3A4050', lineHeight: 1.5, marginTop: 6 }}>
                    以 HR 提供的考核标的、岗位、人员为输入，逐项梳理所需业务数据：数据源、数据类型、传输方式、更新频率、可见范围。
                </Text>
                <Text style={{ fontSize: 10.5, color: '#C43A17', lineHeight: 1.35, marginTop: 6 }}>
                    前提条件写进风险清单：若 HR 未在约定时间提供考核标的，该交付物顺延，不自行假设标的。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>30 / 36</Text>
    </Box>
</Slide>
