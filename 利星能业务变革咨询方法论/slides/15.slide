<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            业务现状分析框架 <span style={{ color: '#FA4F24' }}>五维扫描</span>
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            招标要求的五项现状盘点逐项给判据，不采信「基本覆盖」这种说法
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>
        {/* 五维 */}
        {[
            { n: '1', t: '流程现状', c: '#FA4F24', pts: ['盘点到 L3：每个流程域有多少条流程、每条流程多少个关键环节', '判据：能独立指派责任、输入输出明确的才算一条流程', '重点看跨部门交接点，交接次数越多越容易挂起'], d: '产出：流程现状清单（含流程数量）' },
            { n: '2', t: '单据台账', c: '#E0641E', pts: ['每条流程逐环节列出单据名称、份数、填写方、审批方', '判据：同一信息在两张单据上填两遍 = 冗余登记', '收集实际样表，不接受「照标准流程应该这样」的描述'], d: '产出：单据台账矩阵（含样表）' },
            { n: '3', t: '岗位角色', c: '#D2531A', pts: ['每个环节标出责任岗位、审批岗位、协同岗位', '判据：一岗多责且无优先级排序，是审批挂起的常见根因', '角色与组织名对齐，但先画角色再对组织'], d: '产出：岗位角色责任矩阵' },
            { n: '4', t: '系统数据对象', c: '#C43A17', pts: ['每个流程环节标出：由哪个系统的哪个数据对象支撑', '判据：一个流程跨三个系统以上，集成断点就在这里', '同时标出系统里「有但没人用」的数据对象'], d: '产出：系统—流程—数据对象对应表' },
            { n: '5', t: '关键指标口径与取数', c: '#9E3410', pts: ['逐指标问清：业务定义、计算公式、取哪张表、多久更新一次', '判据：同一个指标出现两个版本且没人能裁定，就是治理问题', '口径没定下来的指标，一律标为「口径待裁定」'], d: '产出：指标口径现状表（含冲突标记）' },
        ].map((x, i) => (
            <Box key={x.n} style={{ flex: 1, flexDirection: 'row', gap: 10, alignItems: 'stretch', background: i === 0 ? '#FFF3EE' : '#F7F7F8', borderRadius: 4, borderLeft: '4px solid ' + x.c }}>
                <Box style={{ width: 44, alignItems: 'center', justifyContent: 'center', flexDirection: 'row' }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: x.c }}>{x.n}</Text>
                </Box>
                <Box style={{ width: 128, justifyContent: 'center', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0F1423' }}>{x.t}</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
                    {x.pts.map((p) => (
                        <Text key={p} style={{ fontSize: 10.5, color: '#3A4050', lineHeight: 1.35 }}>{'· ' + p}</Text>
                    ))}
                </Box>
                <Box style={{ width: 246, background: '#FFFFFF', borderRadius: 3, padding: '0 11px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 10.5, color: x.c, fontWeight: 'bold', lineHeight: 1.3 }}>{x.d}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>15 / 36</Text>
    </Box>
</Slide>
