<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            怎么用这一册：<span style={{ color: '#FA4F24' }}>团队、访谈、节奏</span>
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            方法论不落到人头上就只是一本册子——这一页是把它钉到执行层
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>
        {/* 上：三栏 */}
        <Box style={{ height: 274, flexDirection: 'row', gap: 9 }}>
            {[
                {
                    t: '项目团队四角色', c: '#FA4F24', sub: '每个角色对一段交付物负责',
                    rows: [
                        { k: '业务架构组', v: '3 人：BA 负责人 + 2 分析师，对应 L4 子流程与流程领域架构' },
                        { k: '数据架构组', v: '3 人：DA 负责人 + 主数据/指标各 1，对应逻辑实体与指标字典' },
                        { k: '应用与技术组', v: '3 人：AA + TA + 集成，对应功能模块与 AI 技术就绪度' },
                        { k: 'PMO 与评审对接', v: '1 人：负责访谈排期、基线冻结、交付物签收台账' },
                    ],
                },
                {
                    t: '访谈三层法', c: '#E0641E', sub: '招标 3.1.3 要求的三类对象',
                    rows: [
                        { k: '决策层', v: '公司领导：只问经营结果与拍板意愿，不问系统' },
                        { k: '管理层', v: '九个部门负责人：问权责边界与跨部门卡点，最容易出真话' },
                        { k: '骨干层', v: '关键岗位：问实际操作与例外处理，流程颗粒度全靠这一层' },
                        { k: '不发问卷', v: '关键问题当面问，问卷只用来收集单据台账与系统清单' },
                    ],
                },
                {
                    t: '四阶段节奏', c: '#C43A17', sub: '每个阶段的收口都必须过评审',
                    rows: [
                        { k: '现状分析', v: '调研 → 痛点清单 → 五问追根 → 改进方向排序' },
                        { k: '蓝图设计', v: 'BA 先定稿 → DA/AA 跟进 → AI 初识清单 → 组织适配建议' },
                        { k: '需求规格化', v: 'L5-L6 + 实体属性 + 应用特性 → 需求基线评审冻结' },
                        { k: '路线图', v: '分期 → 关键路径 → 投入收益 → 保障机制' },
                    ],
                },
            ].map((g) => (
                <Box key={g.t} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderTop: '3px solid ' + g.c, padding: '12px 14px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: g.c }}>{g.t}</Text>
                    <Text style={{ fontSize: 10.5, color: '#8A8F99', marginTop: 3 }}>{g.sub}</Text>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: 6, marginTop: 10 }}>
                        {g.rows.map((r) => (
                            <Box key={r.k} style={{ background: '#FFFFFF', borderRadius: 3, padding: '7px 10px', flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
                                <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#0F1423' }}>{r.k}</Text>
                                <Text style={{ fontSize: 10, color: '#5A6070', lineHeight: 1.3, marginTop: 2 }}>{r.v}</Text>
                            </Box>
                        ))}
                    </Box>
                </Box>
            ))}
        </Box>

        {/* 中：现场动作三例 */}
        <Box style={{ height: 150, flexDirection: 'column', gap: 6 }}>
            <Box style={{ height: 22, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                <Box style={{ width: 4, height: 15, background: '#FA4F24' }} />
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F1423' }}>三个现场动作（评审时可以直接演示）</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 7 }}>
                {[
                    { t: '随机抽一个业务对象问四句', d: '「它在哪几个系统里？叫什么名？有几份？谁是权威？」四个答案对不上，Y 模型就还没画完——这招五秒出结果，比看 PPT 有用。', c: '#FA4F24' },
                    { t: '当场挑一条痛点走四段追溯', d: '从现象出发，追五层到根因，再推一条变革建议，最后落到一条系统需求。走不通当场说走不通，不用圆。', c: '#E0641E' },
                    { t: '让客户自己说出交叉点', d: '问「哪两个部门的数据最常打架」，客户说出来的第一个答案，就是主数据和指标体系的落点。', c: '#C43A17' },
                ].map((x) => (
                    <Box key={x.t} style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid ' + x.c, padding: '10px 13px', flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: x.c }}>{x.t}</Text>
                        <Text style={{ fontSize: 11, color: '#3A4050', lineHeight: 1.45, marginTop: 5 }}>{x.d}</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 下 */}
        <Box style={{ flex: 1, background: '#0F1423', borderRadius: 4, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FBA15C', width: 176 }}>这一册的用法</Text>
            <Text style={{ fontSize: 14, color: '#FFFFFF', flex: 1, lineHeight: 1.5 }}>
                评审时按第 06 页逐条念、按第 04 页讲顺序、按第 09 页交颗粒度、按第 10 页交追溯 —— 这四页是承诺，其余页是做法
            </Text>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>12 / 36</Text>
    </Box>
</Slide>
