<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            九个参与部门 <span style={{ color: '#FA4F24' }}>×</span> 4A 关注点矩阵
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            每个部门访谈必问的三件事——避免九个部门都问成同一批通用问题
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 7 }}>
        {/* 表头 */}
        <Box style={{ height: 26, flexDirection: 'row', gap: 4 }}>
            <Box style={{ width: 148, background: '#0F1423', borderRadius: 3, padding: '0 10px', flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FFFFFF' }}>部门</Text>
            </Box>
            <Box style={{ width: 62, background: '#0F1423', borderRadius: 3, alignItems: 'center', justifyContent: 'center', flexDirection: 'row' }}>
                <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FFFFFF' }}>主责域</Text>
            </Box>
            <Box style={{ flex: 1, background: '#0F1423', borderRadius: 3, padding: '0 10px', flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FFFFFF' }}>业务域归属</Text>
            </Box>
            <Box style={{ flex: 1.6, background: '#0F1423', borderRadius: 3, padding: '0 10px', flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FFFFFF' }}>这个部门的必问三件事</Text>
            </Box>
        </Box>

        {/* 九行 */}
        {[
            { d: '公司领导', a: 'BA', b: 'E1 开发与投资 / 总体', q: '这次变革最想改变哪个经营结果？哪些事情你愿意亲自拍板？', c: '#C43A17' },
            { d: '电站开发部', a: 'BA', b: 'E1 开发与投资', q: '一个项目从机会到投资决策要过几道会？哪一步最慢最卡？', c: '#FA4F24' },
            { d: '产品解决方案部', a: 'BA+DA', b: 'S2 EBOM→MBOM', q: '同一个产品不同配置，物料清单怎么合？差异谁说了算？', c: '#0F1423' },
            { d: '项目管理部', a: 'BA', b: 'E2 建设', q: '进度、成本、变更三张表的数据从哪来？更新到不及时谁负责？', c: '#E0641E' },
            { d: '工程技术部', a: 'TA+BA', b: 'E2/E3 工程与运维', q: '设备台账、设计文档、缺陷记录三套数据能不能对上？', c: '#D2531A' },
            { d: '能源运营技术部', a: 'BA', b: 'E3 运营运维（含资产）', q: '一次检修从计划到闭环要几个系统？资产口径和财务口径一致吗？', c: '#C43A17' },
            { d: '投融资部', a: 'BA+DA', b: 'E1/E5 四算', q: '可研测算用的历史数据从哪取？口径和财务对得上吗？', c: '#9E3410' },
            { d: '财务部', a: 'DA', b: 'E5 四算 / 指标', q: '一个数字要出三个版本时，谁是最终裁定人？', c: '#3A4050' },
            { d: '金融资产部', a: 'DA', b: 'E3 资产管理', q: '资产台账的价值口径、折旧口径与运维口径差在哪？', c: '#5A6070' },
            { d: '制造中心', a: 'BA+DA', b: 'S1 采购履行 / S2 转化', q: '紧急采购怎么走？供应商准入谁卡？为什么卡？', c: '#3A4050' },
        ].map((r) => (
            <Box key={r.d} style={{ flex: 1, flexDirection: 'row', gap: 4, alignItems: 'stretch' }}>
                <Box style={{ width: 148, background: '#F7F7F8', borderRadius: 3, borderLeft: '3px solid ' + r.c, padding: '0 10px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#0F1423' }}>{r.d}</Text>
                </Box>
                <Box style={{ width: 62, alignItems: 'center', justifyContent: 'center', flexDirection: 'row' }}>
                    <Box style={{ height: 18, padding: '0 5px', borderRadius: 2, background: r.c, alignItems: 'center', justifyContent: 'center', flexDirection: 'row' }}>
                        <Text style={{ fontSize: 10, fontWeight: 'bold', color: '#FFFFFF' }}>{r.a}</Text>
                    </Box>
                </Box>
                <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, padding: '0 10px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 11, color: '#5A6070', lineHeight: 1.3 }}>{r.b}</Text>
                </Box>
                <Box style={{ flex: 1.6, background: '#FFF3EE', borderRadius: 3, padding: '0 11px', flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 11.5, color: '#0F1423', lineHeight: 1.3 }}>{r.q}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>08 / 36</Text>
    </Box>
</Slide>
