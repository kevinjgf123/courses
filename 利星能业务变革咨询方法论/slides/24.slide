<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            应用蓝图：<span style={{ color: '#FA4F24' }}>分域分层</span> + 集成架构，到功能模块
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            招标 3.3.2 三条要求：应用域划分与功能分布、集成架构（方式/协议/流转/调用）、颗粒度到功能模块
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>
        {/* 上：分层 */}
        <Box style={{ height: 22, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 4, height: 16, background: '#FA4F24' }} />
            <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0F1423' }}>① 应用分域分层：三个应用域 + 三层能力</Text>
        </Box>
        <Box style={{ height: 210, flexDirection: 'row', gap: 8, alignItems: 'stretch' }}>
            {[
                {
                    t: '运营支撑域', c: '#FA4F24', d: 'E3 运营运维 + E4 交易',
                    mods: ['资产台账', '缺陷工单', '检修计划', '两票与安全', '交易申报', '结算对账'],
                },
                {
                    t: '项目交付域', c: '#E0641E', d: 'E1 开发与投资 + E2 建设 + E5 四算',
                    mods: ['项目立项', '可研测算', '设计管理', '进度成本', '采购履行', '四算管理'],
                },
                {
                    t: '产品制造域', c: '#C43A17', d: 'S1 采购协同 + S2 转化',
                    mods: ['供应商管理', '寻源比价', 'EBOM 管理', '转换规则库', '到货检验'],
                },
            ].map((x) => (
                <Box key={x.t} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderTop: '3px solid ' + x.c, padding: '11px 13px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: x.c }}>{x.t}</Text>
                    <Text style={{ fontSize: 10, color: '#8A8F99', marginTop: 3 }}>{x.d}</Text>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: 4, marginTop: 8 }}>
                        {x.mods.map((m) => (
                            <Box key={m} style={{ background: '#FFFFFF', borderRadius: 3, padding: '0 9px', flex: 1, flexDirection: 'row', alignItems: 'center', border: '1px solid #E8E8E8', minHeight: 0 }}>
                                <Text style={{ fontSize: 10.5, color: '#3A4050' }}>功能模块 · {m}</Text>
                            </Box>
                        ))}
                    </Box>
                </Box>
            ))}
            <Box style={{ width: 268, background: '#0F1423', borderRadius: 4, padding: '12px 14px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 12, color: '#FBA15C', letterSpacing: 1 }}>三层能力划分</Text>
                {[
                    { l: 'L1 业务应用层', v: '面向岗位的应用，功能模块所在层' },
                    { l: 'L2 共享能力层', v: '主数据、台账、规则、流程引擎' },
                    { l: 'L3 集成与数据层', v: '接口网关、消息、数据交换' },
                ].map((x, i) => (
                    <Box key={x.l} style={{ background: 'rgba(255,255,255,0.08)', borderRadius: 3, padding: '0 10px', marginTop: i === 0 ? 8 : 5, flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FFFFFF' }}>{x.l}</Text>
                        <Text style={{ fontSize: 10, color: 'rgba(255,255,255,0.8)', lineHeight: 1.3, marginTop: 2 }}>{x.v}</Text>
                    </Box>
                ))}
                <Box style={{ background: 'rgba(250,79,36,0.18)', borderRadius: 3, padding: '7px 10px', marginTop: 7, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 10.5, color: '#FBA15C', lineHeight: 1.35 }}>
                        跨域共享能力只建一次
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 中：集成架构四要素 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 8, alignItems: 'stretch' }}>
            <Box style={{ width: 690, background: '#F7F7F8', borderRadius: 4, padding: '11px 14px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423' }}>② 应用集成架构四要素（逐对列明，不允许留空）</Text>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 4, marginTop: 7 }}>
                    {[
                        { a: '集成方式', v: '实时同步 / 批量 / 消息 / 文件 / 人工——目标态不允许「人工」' },
                        { a: '集成协议', v: 'API / 消息队列 / 数据库视图 / 文件格式，逐条定' },
                        { a: '数据流转', v: '来源系统 → 目标系统 → 传哪些实体 → 同步频率与延迟要求' },
                        { a: '服务调用', v: '跨应用调用的服务清单、调用方向、超时与重试策略' },
                    ].map((x) => (
                        <Box key={x.a} style={{ flex: 1, background: '#FFFFFF', borderRadius: 3, padding: '0 11px', flexDirection: 'row', alignItems: 'center', gap: 10, border: '1px solid #E8E8E8' }}>
                            <Box style={{ width: 78, height: 20, borderRadius: 2, background: '#FA4F24', alignItems: 'center', justifyContent: 'center', flexDirection: 'row' }}>
                                <Text style={{ fontSize: 10.5, fontWeight: 'bold', color: '#FFFFFF' }}>{x.a}</Text>
                            </Box>
                            <Text style={{ fontSize: 10.5, color: '#3A4050', flex: 1, lineHeight: 1.35 }}>{x.v}</Text>
                        </Box>
                    ))}
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '12px 15px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#C43A17' }}>功能模块级设计：三条判据</Text>
                {[
                    '模块名与业务语言一致：叫「缺陷工单」不要叫「问题处理」，叫「检修计划」不要叫「维护管理」',
                    '每个模块标注它支撑哪几条 L4、依赖哪些逻辑实体',
                    '模块边界即应用边界：两个模块要共享同一份主数据，就必须放同一个应用',
                ].map((t, i) => (
                    <Box key={t} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 8, flex: 1, marginTop: i === 0 ? 6 : 3 }}>
                        <Text style={{ fontSize: 10, color: '#FA4F24', fontWeight: 'bold' }}>▪</Text>
                        <Text style={{ fontSize: 11, color: '#3A4050', flex: 1, lineHeight: 1.4 }}>{t}</Text>
                    </Box>
                ))}
                <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#C43A17', marginTop: 7, lineHeight: 1.35 }}>
                    颗粒度到功能模块，不下到页面。页面级设计属于系统实现阶段，放进咨询会越界。
                </Text>
            </Box>
        </Box>

        {/* 下 */}
        <Box style={{ height: 30, flexDirection: 'row', gap: 7 }}>
            {[
                { k: '演进路径要写', v: '现状 → 目标态分几步、每步投入多少', c: '#FA4F24', dark: true },
                { k: '不拆现有系统', v: '蓝图不预设推倒重来，只给演进路径与替换顺序', c: '#E0641E', dark: false },
                { k: '集成债要销账', v: '阶段一列的弱集成，逐条给出目标处理方式', c: '#C43A17', dark: false },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: x.dark ? '#0F1423' : '#F7F7F8', borderLeft: '4px solid ' + x.c, borderRadius: 3, padding: '0 12px', flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: x.dark ? '#FBA15C' : '#0F1423' }}>{x.k}</Text>
                    <Text style={{ fontSize: 10, color: x.dark ? 'rgba(255,255,255,0.86)' : '#5A6070', flex: 1, lineHeight: 1.3 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>24 / 36</Text>
    </Box>
</Slide>
