<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            数据现状分析框架 <span style={{ color: '#FA4F24' }}>含主数据与治理</span>
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            能源与储能两条链的数据问题八成不在存储上，在主数据没人认领
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>
        {/* 上：主数据八类识别 */}
        <Box style={{ height: 152, flexDirection: 'column', gap: 6 }}>
            <Box style={{ height: 22, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                <Box style={{ width: 4, height: 15, background: '#FA4F24' }} />
                <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0F1423' }}>主数据八类识别（逐类回答四问：谁认领 · 在哪维护 · 谁是权威 · 编码规则是什么）</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 5 }}>
                {[
                    { t: '组织与人员', d: '含项目部、班组、岗位', c: '#FA4F24' },
                    { t: '客户与供应商', d: '采购与售电两侧主体', c: '#FA4F24' },
                    { t: '物料 / 设备', d: 'BOM 基础，两条链共用', c: '#FA4F24' },
                    { t: '电站资产', d: '机组、场站、组件', c: '#E0641E' },
                    { t: '项目', d: '在建与存量项目编码', c: '#E0641E' },
                    { t: '合同', d: '框架与具体合同', c: '#E0641E' },
                    { t: '产品与配置', d: 'EBOM 版本与配置项', c: '#C43A17' },
                    { t: '指标', d: '口径本身即主数据', c: '#C43A17' },
                ].map((x) => (
                    <Box key={x.t} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderTop: '3px solid ' + x.c, padding: '9px 9px', flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423', lineHeight: 1.25 }}>{x.t}</Text>
                        <Text style={{ fontSize: 10, color: '#8A8F99', lineHeight: 1.3, marginTop: 4 }}>{x.d}</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 中：治理四问 + 最小可行治理 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 9, alignItems: 'stretch' }}>
            <Box style={{ width: 550, background: '#0F1423', borderRadius: 4, padding: '13px 16px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 12, color: '#FBA15C', letterSpacing: 1 }}>治理现状四问（答不上来就是空白区）</Text>
                {[
                    { q: '权责', d: '每类主数据有没有明确认领部门？没有认领的，规则会自然分叉' },
                    { q: '流程', d: '新增/变更/停用走不走审批？绕过流程直接改库的入口封了没有' },
                    { q: '标准', d: '编码、命名、取值域有没有标准？标准文档是否在版本控制中' },
                    { q: '质量', d: '完整率、唯一率、引用完整性有没有在定期度量？没有度量就没有改进' },
                ].map((x, i) => (
                    <Box key={x.q} style={{ flexDirection: 'row', alignItems: 'center', gap: 10, flex: 1, marginTop: i === 0 ? 9 : 4 }}>
                        <Box style={{ width: 40, height: 19, borderRadius: 2, background: '#FA4F24', alignItems: 'center', justifyContent: 'center', flexDirection: 'row' }}>
                            <Text style={{ fontSize: 10.5, fontWeight: 'bold', color: '#FFFFFF' }}>{x.q}</Text>
                        </Box>
                        <Text style={{ fontSize: 11.5, color: 'rgba(255,255,255,0.88)', flex: 1, lineHeight: 1.3 }}>{x.d}</Text>
                    </Box>
                ))}
            </Box>
            <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '13px 16px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#C43A17' }}>诊断结论只出「最小可行治理清单」</Text>
                <Text style={{ fontSize: 11.5, color: '#3A4050', lineHeight: 1.5, marginTop: 7, flex: 1 }}>
                    不在诊断阶段推全量治理体系。能源项目真正卡住建设的，通常就是三件事：设备台账口径不统一、供应商编码与财务不一致、指标同名不同义。先把这三类的责任人和标准定下来，其余分期做。
                </Text>
                <Text style={{ fontSize: 11, color: '#C43A17', lineHeight: 1.4, marginTop: 6 }}>
                    判据：清单里每一项都要有「认领部门 + 完成标准」，写不出这两样的不写进清单。
                </Text>
            </Box>
        </Box>

        {/* 下：数据现状盘点四产出 */}
        <Box style={{ height: 48, flexDirection: 'row', gap: 7 }}>
            {[
                { k: '数据资产目录现状', v: '已有目录覆盖哪些主题域、缺哪些' },
                { k: '逻辑实体现状', v: '已定义实体数、重复实体、无主实体' },
                { k: '数据标准现状', v: '已有标准数、覆盖率、冲突数' },
                { k: '数据分布现状', v: '同一实体跨几套库、有几份副本' },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderLeft: '4px solid #E0641E', padding: '0 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#0F1423' }}>{x.k}</Text>
                    <Text style={{ fontSize: 10, color: '#5A6070', lineHeight: 1.3, marginTop: 2 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>16 / 36</Text>
    </Box>
</Slide>
