<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            业务域地图：<span style={{ color: '#FA4F24' }}>能源七块</span> + 储能两块
        </Text>
        <Text style={{ fontSize: 19, color: '#8A8F99', marginTop: 7 }}>
            每一块的流程形态、数据特征、AI 落点都不同，不能用一套模板扫过去
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 10, paddingBottom: 6, height: 479, flexDirection: 'column', gap: 8 }}>

        {/* 能源链：五段 */}
        <Box style={{ height: 22, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 4, height: 16, background: '#FA4F24' }} />
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F1423' }}>能源业务链（招标 3.1.1）</Text>
            <Text style={{ fontSize: 11, color: '#8A8F99' }}>从投资到运营的价值流转，五块各有独立流程形态</Text>
        </Box>
        <Box style={{ height: 116, flexDirection: 'row', gap: 5 }}>
            {[
                { n: 'E1', t: '开发与投资', d: '项目机会筛选、可研测算、投资决策', ch: '长周期 · 强合规 · 文档驱动', ai: '尽调与可研加速', c: '#FA4F24' },
                { n: 'E2', t: '建设', d: '设计、采购、施工、监理、进度与验收', ch: '现场为主 · 大量工程数据', ai: '进度偏差预警 / 文档智能核对', c: '#E0641E' },
                { n: 'E3', t: '运营运维', d: '含资产管理：设备台账、缺陷工单、检修计划', ch: '资产为核 · 时序数据为主', ai: '缺陷预判 / 检修策略推荐', c: '#D2531A' },
                { n: 'E4', t: '交易', d: '电力市场交易申报、结算、偏差与风险敞口', ch: '高频 · 强时效 · 规则驱动', ai: '报价策略与风险提示', c: '#C43A17' },
                { n: 'E5', t: '项目四算', d: '概算、预算、竣工决算、运营成本核算', ch: '算量规则复杂 · 追溯要求极高', ai: '算量与差异归因辅助', c: '#9E3410' },
            ].map((x) => (
                <Box key={x.n} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, borderTop: '3px solid ' + x.c, padding: '9px 10px', flexDirection: 'column' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: x.c }}>{x.n}</Text>
                        <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0F1423' }}>{x.t}</Text>
                    </Box>
                    <Text style={{ fontSize: 10.5, color: '#5A6070', lineHeight: 1.35, marginTop: 5, flex: 1 }}>{x.d}</Text>
                    <Text style={{ fontSize: 9.5, color: '#8A8F99', lineHeight: 1.3 }}>{x.ch}</Text>
                    <Text style={{ fontSize: 9.5, color: x.c, lineHeight: 1.3, marginTop: 2 }}>AI：{x.ai}</Text>
                </Box>
            ))}
        </Box>

        {/* 能源：指标体系 */}
        <Box style={{ height: 40, flexDirection: 'row', gap: 10, alignItems: 'stretch' }}>
            <Box style={{ width: 244, background: '#0F1423', borderRadius: 4, padding: '0 15px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#FBA15C' }}>E6　指标体系建设（横切）</Text>
                <Text style={{ fontSize: 10, color: 'rgba(255,255,255,0.78)', marginTop: 2 }}>穿透前五块，单独成交付物</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '0 15px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Text style={{ fontSize: 11.5, color: '#3A4050', flex: 1, lineHeight: 1.4 }}>
                    核心动作：指标名称与编码、业务定义、计算公式、计量单位、统计周期、数据来源与取数口径、业务与数据责任人、有效期与使用场景 —— 八要素缺一项就不进指标字典
                </Text>
            </Box>
        </Box>

        {/* 储能 */}
        <Box style={{ height: 22, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 4, height: 16, background: '#5A6070' }} />
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F1423' }}>储能业务链（招标 3.1.1）</Text>
            <Text style={{ fontSize: 11, color: '#8A8F99' }}>制造侧衔接，核心矛盾在 EBOM 到 MBOM 的转化</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'row', gap: 8, alignItems: 'stretch' }}>
            <Box style={{ width: 456, background: '#F7F7F8', borderRadius: 4, borderTop: '3px solid #3A4050', padding: '10px 14px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#3A4050' }}>S1　采购履行与协同管理</Text>
                <Text style={{ fontSize: 11, color: '#5A6070', lineHeight: 1.4, marginTop: 5, flex: 1 }}>
                    寻源、询比价、订单、催交、到货检验、入库 —— 与能源建设链在采购侧交汇，是两条链的公共域
                </Text>
                <Text style={{ fontSize: 10, color: '#8A8F99' }}>共建对象：采购履行中台 · 与 E2 共用供应商与物料主数据</Text>
            </Box>
            <Box style={{ width: 456, background: '#F7F7F8', borderRadius: 4, borderTop: '3px solid #0F1423', padding: '10px 14px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F1423' }}>S2　EBOM → MBOM 转化</Text>
                <Text style={{ fontSize: 11, color: '#5A6070', lineHeight: 1.4, marginTop: 5, flex: 1 }}>
                    设计 BOM 到制造 BOM 的逐层展开、工艺路线配套、替代料规则 —— 本项目数据架构最难的一块，也是主数据与流程的交叉点
                </Text>
                <Text style={{ fontSize: 10, color: '#C43A17' }}>风险：转换规则不沉淀成系统能力，每接一个新产品都要重做一遍</Text>
            </Box>
            <Box style={{ flex: 1, background: '#0F1423', borderRadius: 4, padding: '10px 15px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12, color: '#FBA15C', letterSpacing: 1 }}>两条链的公共底座</Text>
                <Text style={{ fontSize: 11.5, color: '#FFFFFF', lineHeight: 1.45, marginTop: 6 }}>
                    物料/供应商主数据、组织与人员、项目编码、指标口径 —— 这四样在两条链上各存一份，整套架构就废了
                </Text>
                <Text style={{ fontSize: 10, color: 'rgba(255,255,255,0.7)', marginTop: 6 }}>跨链一致性是本次诊断的第一优先级</Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · 利星能业务变革咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>07 / 36</Text>
    </Box>
</Slide>
