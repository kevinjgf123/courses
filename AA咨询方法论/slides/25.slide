<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
   之方法：<span style={{ color: '#FA4F24' }}>应用减法三步法</span>，比新建更需要方法论
      </Text>
     <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
 停止新增容易，难的是让一个跑了十年的系统真正下线
    </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 14 }}>
    {[
     {
   n: 'STEP 1', t: '找', c: '#0F1423', tc: '#FFFFFF',
   d: '调用量归零 + 12 个月无变更 + 无对应业务能力',
     pts: ['网关日志与数据库连接池，确认真实调用', '代码仓库提交记录，找出最后的活人', '别信登记表，要信流量和提交记录'],
        },
        {
   n: 'STEP 2', t: '迁', c: '#FA4F24', tc: '#FFFFFF',
   d: '功能迁到存留应用，数据归档，接口改向',
   pts: ['功能不是砍掉，是搬到一个还在演进的系统里', '历史数据按监管年限归档，可查询不可在线', '所有消费方一次性切完，不留双跑'],
  },
    {
       n: 'STEP 3', t: '撤', c: '#FBA15C', tc: '#3A2000',
   d: '下线环境、回收账号、注销域名、留档案',
        pts: ['代码仓库只归档不删除，法律上仍需可追溯', '账号与密钥必须从 IAM 里真实移除', '写一份《下线确认书》交给运维和审计'],
    },
      ].map((it, i) => (
      <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', gap: 14 }}>
    <Box style={{ width: 116, background: it.c, borderRadius: 4, alignItems: 'center', justifyContent: 'center', flexDirection: 'column' }}>
   <Text style={{ fontSize: 13, fontWeight: 'bold', color: it.tc, letterSpacing: 1 }}>{it.n}</Text>
   <Text style={{ fontSize: 30, fontWeight: 'bold', color: it.tc, marginTop: 2 }}>{it.t}</Text>
  </Box>
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 5 }}>
   <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F1423' }}>{it.d}</Text>
       {it.pts.map((p, j) => (
     <Text key={j} style={{ fontSize: 13, color: '#3A4050', lineHeight: 1.45 }}>· {p}</Text>
       ))}
        </Box>
            {i < 2 && (
         <Box style={{ width: 26, alignItems: 'center', justifyContent: 'center' }}>
   <Text style={{ fontSize: 18, color: '#FA4F24', fontWeight: 'bold' }}>↓</Text>
    </Box>
     )}
       </Box>
      ))}
        <Box style={{ height: 66, background: 'linear-gradient(90deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '0 18px', flexDirection: 'row', alignItems: 'center' }}>
      <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', width: 168 }}>★ 为什么大多数组织做不成</Text>
 <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.95)', flex: 1, lineHeight: 1.45 }}>
      不是不想减，是没人愿意签这个字。减法没有交付里程碑，只有风险。必须由架构治理委员会强行立项，
       把「下线」当成一个可考核的项目来管，而不是当成 IT 内部杂事。
        </Text>
     </Box>
 </Box>

    {/* C 区 */}
  <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
    <Box style={{ width: 10, height: 10, background: '#FA4F24' }} />
   <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · AA应用架构咨询方法论</Text>
        <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 'auto' }}>25 / 30</Text>
  </Box>
</Slide>