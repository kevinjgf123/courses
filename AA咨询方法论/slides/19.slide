<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            之模板：<span style={{ color: '#FA4F24' }}>应用热力图与四态决策表</span>，结论必须逐项落地
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
     决策表最右边那一列「落地计划」是全表的重点——没有计划表的决策表只是一张愿望清单
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 22 }}>

    {/* 左 热力图 */}
   <Box style={{ width: 600, border: '1px solid #E8E8E8', borderRadius: 4, padding: '10px 18px', flexDirection: 'column' }}>
   <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderBottom: '2px solid #FA4F24', paddingBottom: 10 }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F1423' }}>应用组合热力图</Text>
       <Text style={{ fontSize: 12, color: '#8A8F99' }}>横轴=技术健康度 · 纵轴=业务价值 · 点内数字=应用编号</Text>
            </Box>
       <Box style={{ flexDirection: 'row', gap: 6, marginTop: 12, flex: 1 }}>
            <Box style={{ width: 60, flexDirection: 'column', justifyContent: 'space-around' }}>
   {['A 核心', 'B 支撑', 'C 工具'].map((t, i) => (
  <Box key={i} style={{ height: 62, justifyContent: 'center' }}>
        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#0F1423' }}>{t}</Text>
   </Box>
          ))}
        </Box>
 <Box style={{ flex: 1, flexDirection: 'column', gap: 5 }}>
     {[
{ cells: [{ v: 'ORD-001', c: '#FBA15C' }, { v: 'FIN-003', c: '#F8622F' }, { v: 'PRD-002', c: '#FA4F24' }] },
   { cells: [{ v: 'SCM-005', c: '#F8622F' }, { v: 'HRM-004', c: '#FDC69A' }, { v: 'OLD-012', c: '#B8BDC7' }] },
   { cells: [{ v: 'RPT-008', c: '#D8DCE3' }, { v: 'TOOL-021', c: '#D8DCE3' }, { v: 'TMP-033', c: '#B8BDC7' }] },
     ].map((row, i) => (
          <Box key={i} style={{ flex: 1, flexDirection: 'row', gap: 5 }}>
   {row.cells.map((c, j) => (
            <Box key={j} style={{ flex: 1, background: c.c, borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
  <Text style={{ fontSize: 13, fontWeight: 'bold', color: c.c === '#FA4F24' || c.c === '#F8622F' ? '#FFFFFF' : '#3A4050' }}>{c.v}</Text>
          </Box>
              ))}
      </Box>
       ))}
   </Box>
            </Box>
    <Box style={{ flexDirection: 'row', gap: 12, marginTop: 6, alignItems: 'center' }}>
     <Text style={{ fontSize: 11, color: '#8A8F99' }}>业务价值</Text>
       {[{ t: 'A', c: '#FA4F24' }, { t: 'B', c: '#FBA15C' }, { t: 'C', c: '#B8BDC7' }].map((g, i) => (
         <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 5 }}>
     <Box style={{ width: 16, height: 10, background: g.c, borderRadius: 2 }} />
       <Text style={{ fontSize: 11, color: '#3A4050' }}>{g.t}</Text>
      </Box>
      ))}
     <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 11, color: '#8A8F99' }}>技术健康度</Text>
        {[{ t: 'A', c: '#FA4F24' }, { t: 'B', c: '#F8622F' }, { t: 'C', c: '#FDC69A' }, { t: 'D', c: '#B8BDC7' }].map((g, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 5 }}>
   <Box style={{ width: 16, height: 10, background: g.c, borderRadius: 2 }} />
     <Text style={{ fontSize: 11, color: '#3A4050' }}>{g.t}</Text>
       </Box>
        ))}
     </Box>
        </Box>

        {/* 右 决策表 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F1423' }}>四态决策表</Text>
            <Box style={{ border: '1px solid #E8E8E8', borderRadius: 4, flex: 1, flexDirection: 'column' }}>
   {[
         { k: 'AA-ORD-001', v: 'A / B', d: '维持', c: '#FBA15C', tc: '#3A2000', p: '2027 H2 启动 Oracle 升级' },
        { k: 'AA-PRD-002', v: 'A / D', d: '重构', c: '#FA4F24', tc: '#FFFFFF', p: '2026 H1 第一波，已立项' },
   { k: 'AA-SCM-005', v: 'B / D', d: '集成', c: '#F8622F', tc: '#FFFFFF', p: '2026 H2 并入订单中心' },
        { k: 'AA-RPT-008', v: 'B / C', d: '集成', c: '#FDC69A', tc: '#3A2000', p: '2026 H4 接入数据服务' },
     { k: 'AA-OLD-012', v: 'B / D', d: '退役', c: '#B8BDC7', tc: '#3A4050', p: '2026 H3 数据归档后下线' },
        { k: 'AA-TMP-033', v: 'C / D', d: '退役', c: '#B8BDC7', tc: '#3A4050', p: '2026 H2 直接清理' },
  ].map((it, i) => (
     <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 8, background: i % 2 === 0 ? '#F7F7F8' : '#FFFFFF', padding: '0 10px' }}>
       <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#0F1423', width: 88 }}>{it.k}</Text>
     <Text style={{ fontSize: 11, color: '#8A8F99', width: 42 }}>{it.v}</Text>
     <Box style={{ width: 44, background: it.c, borderRadius: 2, padding: '4px 0', alignItems: 'center' }}>
     <Text style={{ fontSize: 11, fontWeight: 'bold', color: it.tc }}>{it.d}</Text>
       </Box>
    <Text style={{ fontSize: 10, color: '#3A4050', flex: 1, lineHeight: 1.3 }}>{it.p}</Text>
      </Box>
  ))}
        </Box>
   <Box style={{ height: 96, background: 'linear-gradient(160deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '12px 16px', flexDirection: 'column', justifyContent: 'center' }}>
     <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>★ 两条硬规则</Text>
  <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.95)', lineHeight: 1.55, marginTop: 5 }}>
        ① 每个应用必须给出决策，不允许留空；<br />
        ② 「维持」也要写下次复评时间——不做「永久维持」这个结论。
   </Text>
        </Box>
   </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
     <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
     <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · AA应用架构咨询方法论</Text>
  </Box>
    <Text style={{ fontSize: 14, color: '#8A8F99' }}>19 / 30</Text>
    </Box>
</Slide>