<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            之内容：<span style={{ color: '#FA4F24' }}>业务术语、同义词与数据标准</span>，把「各说各的」变成「共同语言」
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            数据标准落到属性层：定义公司层面需共同遵守的属性含义与业务规则，防止上下游各自定义、反复翻译
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 22 }}>

        {/* 左 同义词示例 */}
        <Box style={{ width: 600, flexDirection: 'column', gap: 14 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423' }}>示例：同义词收敛（业务视角）</Text>
            <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '18px 20px', flexDirection: 'column' }}>
                {[
                    { u: '客户名称 / 客户名 / 客商名称 / 买方名称', s: '统一为 → 客户名称' },
                    { u: '合同号 / 合同编号 / 协议编号', s: '统一为 → 合同编号' },
                    { u: '物料编码 / 物料号 / 产品编码 / SKU', s: '统一为 → 物料编码' },
                ].map((it, i) => (
                    <Box key={i} style={{ flexDirection: 'column', background: '#FFFFFF', borderRadius: 3, padding: '13px 16px', marginBottom: i < 2 ? 11 : 0 }}>
                        <Text style={{ fontSize: 14, color: '#3A4050', lineHeight: 1.4 }}>{it.u}</Text>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C43A17', marginTop: 6 }}>{it.s}</Text>
                    </Box>
                ))}
            </Box>
            <Box style={{ background: 'rgba(250,79,36,0.06)', borderRadius: 4, padding: '14px 18px' }}>
                <Text style={{ fontSize: 15, color: '#3A4050', lineHeight: 1.55 }}>
                    <Text style={{ fontWeight: 'bold', color: '#C43A17' }}>不统一会怎样：</Text>
                    同一份数据在不同环节叫不同名字，下游系统就必须额外做人工转换和翻译，极大增加人工成本、延长业务执行周期。
                </Text>
            </Box>
        </Box>

        {/* 右 三类成果 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 13 }}>
            {[
                { n: '交付物一', t: '业务术语表', d: '统一的企业级业务词汇定义，是数据标准的业务侧基础，也是业务人员与技术人员的翻译表。' },
                { n: '交付物二', t: '数据标准集', d: '按 L5 属性逐条定义业务定义与用途、业务规则、同义词、数据类型长度、允许值。' },
                { n: '交付物三', t: '标准变更流程', d: '标准的申请、评审、发布、废止流程，保证标准能随业务演进而非僵化。' },
            ].map((it, i) => (
                <Box key={i} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '16px 20px', flexDirection: 'column', justifyContent: 'center', borderTop: '4px solid #F87D2F' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#F87D2F' }}>{it.n}</Text>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F1423', marginTop: 8 }}>{it.t}</Text>
                    <Text style={{ fontSize: 15, color: '#3A4050', lineHeight: 1.5, marginTop: 8 }}>{it.d}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · DA数据架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>19 / 31</Text>
    </Box>
</Slide>
