<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            之内容：<span style={{ color: '#FA4F24' }}>目录全集</span>与认责落位，回答「企业数据有哪些、在哪里」
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            目录不只是分类，更是认责的载体 —— L3 归业务 Owner，L4/L5 归数据管家
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 16 }}>

        {/* 上 以生产制造为例 */}
        <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '18px 22px', flexDirection: 'column' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F1423' }}>示例：以「生产制造」为例的五层落位</Text>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 14, flex: 1 }}>
                {[
                    { l: 'L1', v: '生产制造管理域' },
                    { l: 'L2', v: '生产计划 / 制造执行 / 外协 / 设备管理' },
                    { l: 'L3', v: '物料需求计划 / 领料单 / 产品 等' },
                    { l: 'L4', v: '产品基本信息 / 生产信息 / 质量信息' },
                    { l: 'L5', v: '产品代码 / 产品名称 等属性' },
                ].map((it, i) => (
                    <Box key={i} style={{ flex: 1, background: i === 2 ? '#FA4F24' : '#FFFFFF', border: i === 2 ? 'none' : '1px solid #E8E8E8', borderRadius: 4, padding: '12px 14px', flexDirection: 'column', height: 108 }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: i === 2 ? '#FFFFFF' : '#FA4F24' }}>{it.l}</Text>
                        <Text style={{ fontSize: 13, color: i === 2 ? '#FFFFFF' : '#3A4050', lineHeight: 1.4, marginTop: 8 }}>{it.v}</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 下 三份成果 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 16 }}>
            {[
                { n: '交付物一', t: '数据资产目录全集', d: '完整的五层清单，覆盖企业全部业务数据资产，可按主题域检索与导航。', k: '数据地图' },
                { n: '交付物二', t: '认责落位表', d: '每层对应的责任主体：L1/L2 由数据专业组织担当，L3 由业务 Owner 担当，L4/L5 由数据管家担当。', k: '责任到人' },
                { n: '交付物三', t: '目录变更规程', d: '新增、合并、废止业务对象的申请与审批流程，保证目录长年可用而不腐化。', k: '持续维护' },
            ].map((it, i) => (
                <Box key={i} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '18px 20px', flexDirection: 'column', borderTop: '4px solid #F87D2F' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#F87D2F' }}>{it.n}</Text>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F1423', marginTop: 10 }}>{it.t}</Text>
                    <Text style={{ fontSize: 15, color: '#3A4050', lineHeight: 1.5, marginTop: 10, flex: 1 }}>{it.d}</Text>
                    <Box style={{ background: 'rgba(250,79,36,0.1)', borderRadius: 3, padding: '7px 10px' }}>
                        <Text style={{ fontSize: 13, color: '#C43A17', textAlign: 'center', fontWeight: 'bold' }}>{it.k}</Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · DA数据架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>15 / 31</Text>
    </Box>
</Slide>
