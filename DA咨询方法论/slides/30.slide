<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            数据消费：用<span style={{ color: '#FA4F24' }}>数据服务</span>替代数据集成，实现「数出一孔」
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            数据搬家次数越多，源头与下游差异越大 —— 服务化是同时拿到效率与安全的唯一解
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 22, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 15 }}>

        {/* 上 对比 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 16 }}>
            <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '18px 22px', flexDirection: 'column', borderTop: '4px solid #C8CCD4' }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#8A8F99' }}>传统数据集成</Text>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#5A6070', marginTop: 8 }}>从一个系统复制到另一个系统</Text>
                <Text style={{ fontSize: 15, color: '#5A6070', lineHeight: 1.55, marginTop: 10, flex: 1 }}>
                    企业规模扩大后，需在几十上百个 IT 系统间集成。复杂度提升带来一系列数据质量问题：
                    数据经过多次搬家后，源头与下游差异巨大，一致性无从保障。
                </Text>
            </Box>
            <Box style={{ width: 60, alignItems: 'center', justifyContent: 'center' }}>
                <Box style={{ width: 44, height: 44, background: '#FA4F24', borderRadius: 22, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>→</Text>
                </Box>
            </Box>
            <Box style={{ flex: 1, background: 'linear-gradient(160deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '18px 22px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: 'rgba(255,255,255,0.85)' }}>数据服务</Text>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF', marginTop: 8 }}>以服务替代搬运</Text>
                <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.95)', lineHeight: 1.55, marginTop: 10, flex: 1 }}>
                    消费者只调用服务接口，不关心数据从哪来、怎么存。这在获取效率与数据安全之间取得了平衡。
                </Text>
            </Box>
        </Box>

        {/* 中 五个价值 */}
        <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '16px 22px', flexDirection: 'column' }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F1423' }}>数据服务带来的五个价值</Text>
            <Box style={{ flexDirection: 'row', gap: 10, marginTop: 12, flex: 1 }}>
                {[
                    { n: '01', t: '数出一孔', d: '保障数据一致性' },
                    { n: '02', t: '技术解耦', d: '消费者不关注技术细节' },
                    { n: '03', t: '敏捷响应', d: '提升数据获取效率' },
                    { n: '04', t: '灵活消费', d: '满足多样消费诉求' },
                    { n: '05', t: '兼顾安全', d: '受控的访问与审计' },
                ].map((it, i) => (
                    <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 3, padding: '12px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FA4F24' }}>{it.n}</Text>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F1423', marginTop: 6 }}>{it.t}</Text>
                        <Text style={{ fontSize: 12, color: '#8A8F99', marginTop: 4, lineHeight: 1.3 }}>{it.d}</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 底 三个1 */}
        <Box style={{ background: 'rgba(250,79,36,0.06)', borderRadius: 4, padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C43A17', whiteSpace: 'nowrap' }}>供应链协同「三个 1」</Text>
            <Text style={{ fontSize: 14, color: '#3A4050', lineHeight: 1.45 }}>
                <Text style={{ fontWeight: 'bold', color: '#0F1423' }}>1 天</Text> 交付已发布数据服务的新场景响应 ·
                <Text style={{ fontWeight: 'bold', color: '#0F1423' }}> 1 周</Text> 完成数据需求上线 ·
                <Text style={{ fontWeight: 'bold', color: '#0F1423' }}> 1 月</Text> 数据问题闭环
            </Text>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · DA数据架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>30 / 31</Text>
    </Box>
</Slide>
