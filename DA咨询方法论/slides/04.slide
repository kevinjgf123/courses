<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            Approach：三阶段推进顺序与<span style={{ color: '#FA4F24' }}>每一步的产出物</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            先做什么、后做什么、按什么顺序——箭头就是施工顺序，每个方框里写的是它必须交出来的东西，没有产出物的框就是空转
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 12, paddingBottom: 8, height: 479, flexDirection: 'column', gap: 9 }}>

        {/* 顶部阶段带 */}
        <Box style={{ height: 40, flexDirection: 'row', gap: 3 }}>
            <Box style={{ width: 72, background: '#5A6070', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>启动</Text>
            </Box>
            {[
                { n: '第一阶段', t: '业务调研与现状诊断', c: '#FA4F24' },
                { n: '第二阶段', t: '信息架构设计与治理', c: '#E0641E' },
                { n: '第三阶段', t: '落地实施与持续运营', c: '#C43A17' },
            ].map((x, i) => (
                <Box key={x.n} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 9, background: x.c, borderRadius: 3 }}>
                    <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#FFFFFF' }}>{x.n}</Text>
                    <Box style={{ width: 1, height: 15, background: 'rgba(255,255,255,0.45)' }} />
                    <Text style={{ fontSize: 13.5, color: 'rgba(255,255,255,0.94)' }}>{x.t}</Text>
                </Box>
            ))}
        </Box>

        {/* 任务区 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 9 }}>

            {/* 左侧竖条 */}
            <Box style={{ width: 56, background: '#0F1423', borderRadius: 3, alignItems: 'center', justifyContent: 'center', padding: '8px 0' }}>
                {['项目', '实施', '任务', '分解'].map((t) => (
                    <Text key={t} style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', marginTop: 4 }}>{t}</Text>
                ))}
            </Box>

            {/* 三行任务链 */}
            <Box style={{ flex: 1, flexDirection: 'column' }}>
                {[
                    {
                        n: '①', c: '#FA4F24',
                        items: [
                            { t: '项目准备', o: '数据架构章程 · 范围边界清单' },
                            { t: '业务战略解读', o: '战略解码 → 数据诉求映射表' },
                            { t: '系统与数据摸底', o: '系统清单 · 数据流现状图' },
                            { t: '四组件成熟度评估', o: '成熟度评估报告 · 差距清单' },
                            { t: '重点场景选择', o: 'Top 场景清单 · 优先级矩阵' },
                        ],
                    },
                    {
                        n: '②', c: '#E0641E',
                        items: [
                            { t: '业务对象识别', o: '对象清单 · 定义卡 · 判定结论' },
                            { t: '五层资产目录', o: 'L1–L5 目录全集 · 认责落位表' },
                            { t: '数据标准制定', o: '业务术语表 · 同义词收敛表 · 标准集' },
                            { t: '企业级数据模型', o: '概念/逻辑/物理三层模型 · 一致性报告' },
                            { t: '数据分布定源', o: 'CRUD 矩阵 · 权威源清单 · 分布图' },
                        ],
                    },
                    {
                        n: '③', c: '#C43A17',
                        items: [
                            { t: '入湖准入与落仓', o: '六标准验收 Checklist · 落仓记录' },
                            { t: '数据服务化改造', o: '服务目录 · 取代集成清单' },
                            { t: 'Owner 与管家任命', o: '责任矩阵 RACI · 考核指标' },
                            { t: '变更与季度复核', o: '变更规程 · 目录分布复核报告' },
                            { t: '价值度量与迭代', o: '消费看板 · 复用率与闭环率' },
                        ],
                    },
                ].map((row, ri) => (
                    <Box key={row.n} style={{ flex: 1, flexDirection: 'column' }}>
                        <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', gap: 5 }}>
                            <Box style={{ width: 24, background: row.c, borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>{row.n}</Text>
                            </Box>
                            {row.items.map((x, i) => (
                                <Box key={x.t} style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', gap: 3 }}>
                                    <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 3, border: '1px solid ' + row.c, padding: '6px 9px', flexDirection: 'column', justifyContent: 'center' }}>
                                        <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#0F1423' }}>{x.t}</Text>
                                        <Text style={{ fontSize: 9.5, color: '#C43A17', marginTop: 4, lineHeight: 1.3 }}>产出：{x.o}</Text>
                                    </Box>
                                    {i < row.items.length - 1 && (
                                        <Box style={{ width: 13, alignItems: 'center', justifyContent: 'center' }}>
                                            <Text style={{ fontSize: 14, fontWeight: 'bold', color: row.c }}>→</Text>
                                        </Box>
                                    )}
                                </Box>
                            ))}
                        </Box>
                        {ri < 2 && (
                            <Box style={{ height: 15, flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
                                <Box style={{ width: 1, height: 15, background: '#FBA15C' }} />
                                <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#FA4F24', marginLeft: 2 }}>↓</Text>
                            </Box>
                        )}
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 底部贯穿条 */}
        <Box style={{ flexDirection: 'row', gap: 9, height: 30 }}>
            <Box style={{ flex: 1, background: '#0F1423', borderRadius: 3, padding: '0 14px', flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#FBA15C', width: 84 }}>顺序铁律</Text>
                <Text style={{ fontSize: 11, color: 'rgba(255,255,255,0.9)', flex: 1 }}>先认对象再建目录 → 先定标准再做模型 → 先锁权威源再谈入湖，顺序错一环，后面全部返工</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, borderLeft: '4px solid #FA4F24', padding: '0 14px', flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423', width: 84 }}>架构治理</Text>
                <Text style={{ fontSize: 11, color: '#5A6070', flex: 1 }}>贯穿三阶段：目录、标准、模型、分布的任何变更都走变更规程，附影响面评估与回滚预案</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 3, borderLeft: '4px solid #F87D2F', padding: '0 14px', flexDirection: 'row', alignItems: 'center' }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423', width: 84 }}>组织与人才</Text>
                <Text style={{ fontSize: 11, color: '#5A6070', flex: 1 }}>贯穿三阶段：数据 Owner、数据管家、数据架构组三层责任到位，并有意识转移与陪跑机制</Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · DA数据架构咨询方法论</Text>
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 'auto' }}>04 / 31</Text>
    </Box>
</Slide>
