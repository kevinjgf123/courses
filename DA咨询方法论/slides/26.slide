<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            之方法：用 <span style={{ color: '#FA4F24' }}>CRUD 矩阵</span>锁定唯一权威数据源
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            数据分布定义数据产生的源头及在各流程、IT 系统间的流动 —— 核心是找出「谁是源头」
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 左标题栏 + 右 CRUD 矩阵 */}
    <Box style={{ paddingTop: 22, paddingBottom: 14, height: 479, flexDirection: 'row', gap: 20 }}>

        {/* 左 30% */}
        <Box style={{
            width: 300, background: 'linear-gradient(160deg, #FA4F24 0%, #F87D2F 100%)',
            borderRadius: 4, padding: 26, flexDirection: 'column', justifyContent: 'space-between',
        }}>
            <Box>
                <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.8)', letterSpacing: 2 }}>STEP 05</Text>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF', marginTop: 12, lineHeight: 1.25 }}>
                    数据源
                    <br />
                    识别法
                </Text>
            </Box>
            <Box>
                <Box style={{ width: 44, height: 4, background: 'rgba(255,255,255,0.7)' }} />
                <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.94)', marginTop: 14, lineHeight: 1.55 }}>
                    权威数据源：业务上<b>首次正式发布</b>该项数据的应用系统，经数据管理专业组织认证。
                </Text>
            </Box>
        </Box>

        {/* 右 CRUD 矩阵 */}
        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423', marginBottom: 10 }}>业务对象 × 应用系统 CRUD 矩阵</Text>
            <Box style={{ border: '1px solid #E8E8E8', borderRadius: 4, overflow: 'hidden', flex: 1 }}>
                <Box style={{ flexDirection: 'row', background: '#FA4F24', padding: '9px 12px' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', flex: 1.6 }}>业务对象</Text>
                    {['ERP', 'CRM', 'MES', 'WMS'].map((h, i) => (
                        <Text key={i} style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', flex: 1, textAlign: 'center' }}>{h}</Text>
                    ))}
                </Box>
                {[
                    ['客户', 'C', 'C', 'R', '—'],
                    ['销售订单', 'C', 'R', 'R', 'R'],
                    ['物料', 'C', 'R', 'R', 'R'],
                    ['库存', 'R', '—', 'C', 'C'],
                    ['发票', 'C', 'R', '—', '—'],
                ].map((row, ri) => (
                    <Box key={ri} style={{ flexDirection: 'row', padding: '10px 12px', background: ri % 2 === 0 ? '#FFFFFF' : '#F7F7F8', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F1423', flex: 1.6 }}>{row[0]}</Text>
                        {row.slice(1).map((c, ci) => (
                            <Box key={ci} style={{ flex: 1, alignItems: 'center' }}>
                                <Text style={{
                                    fontSize: 13, fontWeight: 'bold',
                                    color: c === 'C' ? '#FA4F24' : c === 'R' ? '#5A6070' : '#C8CCD4',
                                }}>{c}</Text>
                            </Box>
                        ))}
                    </Box>
                ))}
            </Box>
            <Box style={{ flexDirection: 'row', gap: 16, marginTop: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FA4F24' }}>C</Text>
                    <Text style={{ fontSize: 13, color: '#5A6070' }}>创建 Create</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#5A6070' }}>R</Text>
                    <Text style={{ fontSize: 13, color: '#5A6070' }}>读取 Read</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <Text style={{ fontSize: 13, color: '#C8CCD4' }}>—</Text>
                    <Text style={{ fontSize: 13, color: '#5A6070' }}>不涉及</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
            <Text style={{ fontSize: 14, color: '#8A8F99' }}>硕磐机密 · DA数据架构咨询方法论</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#8A8F99' }}>26 / 31</Text>
    </Box>
</Slide>
