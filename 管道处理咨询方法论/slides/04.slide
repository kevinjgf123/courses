<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
        之路径：<span style={{ color: '#FA4F24' }}>Approach 八阶段</span>，先做什么后做什么、每步产出什么
      </Text>
      <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
        前两阶段定口径，中间三阶段定版本与发布，后三阶段定可观测与演进；顺序颠倒的代价是把口径问题拖到上线后爆
      </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    <Box style={{ paddingTop: 14, paddingBottom: 8, height: 479, flexDirection: 'column', gap: 7 }}>
      <Box style={{ flexDirection: 'row', gap: 7 }}>
        <Box style={{ width: 46, background: '#0F1423', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>阶段</Text></Box>
        <Box style={{ width: 46, background: '#0F1423', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>性质</Text></Box>
        <Box style={{ flex: 1, background: '#0F1423', padding: '0 12px', justifyContent: 'center' }}><Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>这一步做什么</Text></Box>
        <Box style={{ width: 340, background: '#0F1423', padding: '0 12px', justifyContent: 'center' }}><Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>产出物</Text></Box>
      </Box>

      {[
        { n: '1', k: '治理', t: '盘点源系统与要支撑的场景，先定「为谁而建」', o: '源清单 + 场景清单', c: '#FA4F24' },
        { n: '2', k: '治理', t: '定口径、划边界，设计数据集到本体对象的映射', o: '口径字典 + 本体映射表', c: '#FA4F24' },
        { n: '3', k: '设计', t: '设计连接方式、同步频率、批次与事务粒度', o: '接入方案 + 同步模式表', c: '#F87D2F' },
        { n: '4', k: '设计', t: '设计加工逻辑、清洗规则与五类健康检查', o: '加工逻辑规范 + 质量规则表', c: '#F87D2F' },
        { n: '5', k: '治理', t: '设计版本策略、事务粒度与三层血缘矩阵', o: '版本策略 + 血缘矩阵', c: '#E0651A' },
        { n: '6', k: '工程', t: '设计分支规范、评审、发布与回滚流程', o: '分支规范 + 发布检查表', c: '#E0651A' },
        { n: '7', k: '工程', t: '设计可观测：状态、时间、规模、内容、模式五维检查', o: '健康检查清单 + 告警矩阵', c: '#C43A17' },
        { n: '8', k: '运营', t: '设计演进路线（批→增→流）与旧管道退役预案', o: '演进路线图 + 退役预案', c: '#C43A17' },
      ].map((it, i) => (
        <Box key={it.n} style={{ flex: 1, flexDirection: 'row', gap: 7 }}>
          <Box style={{ width: 46, background: '#F7F7F8', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: it.c }}>{it.n}</Text>
          </Box>
          <Box style={{ width: 46, background: it.k === '治理' ? '#FFF3EE' : '#F7F7F8', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: it.c }}>{it.k}</Text>
          </Box>
          <Box style={{ flex: 1, background: '#F7F7F8', padding: '0 12px', justifyContent: 'center' }}>
            <Text style={{ fontSize: 13, color: '#0F1423' }}>{it.t}</Text>
          </Box>
          <Box style={{ width: 340, background: '#FFF3EE', padding: '0 12px', justifyContent: 'center', borderLeft: '2px solid #FBA15C' }}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#C43A17' }}>{it.o}</Text>
          </Box>
        </Box>
      ))}

      <Box style={{ height: 62, background: '#0F1423', borderRadius: 4, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FBA15C', width: 128 }}>三条硬规则</Text>
        <Box style={{ flex: 1, flexDirection: 'row', gap: 10 }}>
          {[
            { n: '先 batch 后流', d: '先批后增再流，倒过来复杂度指数上升' },
            { n: '先只读后写回', d: '读数跑稳了，再谈 Action 写本体' },
            { n: '先血缘后生产', d: '没有血缘和健康检查，不许上生产' },
          ].map((x, i) => (
            <Box key={x.n} style={{ flex: 1, background: 'rgba(255,255,255,0.07)', borderRadius: 3, padding: '6px 10px' }}>
              <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 7 }}>
                <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FA4F24' }}>{String(i + 1)}</Text>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>{x.n}</Text>
              </Box>
              <Text style={{ fontSize: 10, color: 'rgba(255,255,255,0.6)', marginTop: 2 }}>{x.d}</Text>
            </Box>
          ))}
        </Box>
      </Box>
    </Box>

    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
      <Box style={{ width: 10, height: 10, background: '#FA4F24' }} />
      <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · 管道处理咨询方法论</Text>
      <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 'auto' }}>04 / 30</Text>
    </Box>
</Slide>
