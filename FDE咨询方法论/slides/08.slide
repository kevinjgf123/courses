<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            Echo 必须是<span style={{ color: '#FA4F24' }}>叛逆者</span>：认为「现在这套挺好」的人，找不到值得修的路
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            麦克格鲁的原话——最容易被跳过、但跳过就必然失败的一条用人标准
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    <Box style={{ paddingTop: 20, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 13 }}>

        {/* 上：两种人对比 */}
        <Box style={{ height: 178, flexDirection: 'row', gap: 12 }}>
            {[
                {
                    t: '不是叛逆者', who: '「现有体系够好了」型',
                    d: '熟悉业务、非常敬业、忠诚稳定——正是招聘史上最想招的那种人。',
                    r: ['听到问题先找「是不是流程没走对」', '把改进建议写成现有流程的补充'],
                    c: '#C9CBD1', bad: true,
                },
                {
                    t: '是叛逆者', who: 'heretics 型',
                    d: '同样懂行业，但坚信现有体系不够用。理想人选：前军官、医疗老兵、金融老手。',
                    r: ['先问「为什么这件事现在要人做」', '敢当业务负责人的面说「这个指标是错的」'],
                    c: '#FA4F24', bad: false,
                },
            ].map((x) => (
                <Box key={x.t} style={{ flex: 1, background: x.bad ? '#F7F7F8' : '#0F1423', borderRadius: 4, padding: '13px 18px', flexDirection: 'column' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 9, height: 9, borderRadius: 5, background: x.c }} />
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: x.bad ? '#0F1423' : '#FFFFFF' }}>{x.t}</Text>
                        <Text style={{ fontSize: 12, color: x.bad ? '#8A8F99' : '#FBA15C', marginLeft: 'auto' }}>{x.who}</Text>
                    </Box>
                    <Text style={{ fontSize: 12.5, color: x.bad ? '#3A4050' : 'rgba(255,255,255,0.85)', lineHeight: 1.5, marginTop: 10 }}>{x.d}</Text>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: 8, marginTop: 11 }}>
                        {x.r.map((t, i) => (
                            <Box key={i} style={{ flexDirection: 'row', gap: 9, alignItems: 'flex-start', flex: 1 }}>
                                <Text style={{ fontSize: 12, fontWeight: 'bold', color: x.c, width: 12 }}>·</Text>
                                <Text style={{ fontSize: 12, color: x.bad ? '#3A4050' : 'rgba(255,255,255,0.88)', lineHeight: 1.4, flex: 1 }}>{t}</Text>
                            </Box>
                        ))}
                    </Box>
                </Box>
            ))}
        </Box>

        {/* 中：为什么是死线 + 招聘四问 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 12 }}>
            <Box style={{ width: 424, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '12px 18px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#C43A17' }}>为什么这条是死线</Text>
                <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.55, marginTop: 9, flex: 1 }}>
                    FDE 的产出是「客户没做过的事」。如果派进去的人认为客户现状合理，他的最优策略就是保守——保守的结果是技术完美、零改变。
                </Text>
                <Box style={{ background: '#FFFFFF', borderRadius: 3, padding: '9px 11px', borderLeft: '3px solid #FA4F24' }}>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423', lineHeight: 1.45 }}>
                        保守的 FDE 把 100 天干成 100 天；激进的 FDE 把 100 天干成 30 天并改变一个流程
                    </Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '12px 18px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F1423' }}>招聘时的四个提问（可直接用）</Text>
                {[
                    '讲一个你看不上的行业惯例，说清它为什么错',
                    '你做过的最反常识的一个技术判断是什么',
                    '现场如果客户负责人否定了你的方案，你怎么办',
                    '你上一次说服资深业务负责人改流程是什么时候',
                ].map((q, i) => (
                    <Box key={i} style={{ flexDirection: 'row', gap: 10, marginTop: 9, alignItems: 'center', flex: 1 }}>
                        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#FA4F24', width: 24 }}>Q{i + 1}</Text>
                        <Text style={{ fontSize: 13, color: '#3A4050', lineHeight: 1.4, flex: 1 }}>{q}</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 下：行业反例 + 顶住的四种压力 */}
        <Box style={{ height: 88, flexDirection: 'row', gap: 12 }}>
            <Box style={{ width: 296, background: '#0F1423', borderRadius: 4, padding: '0 15px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 11, color: '#FBA15C', letterSpacing: 1 }}>行业反例</Text>
                <Text style={{ fontSize: 12.5, color: 'rgba(255,255,255,0.85)', marginTop: 6, lineHeight: 1.45, flex: 1 }}>
                    a16z 创始人称 FDE 为「头衔套利」。但这个批评本身说明岗位不可替代——深度集成需要一个专属角色承担。
                </Text>
            </Box>
            {[
                { k: '业务负责人的护身符', v: '「这数我用了三年」——常正是问题本身' },
                { k: 'IT 部门的防火墙', v: '「别碰我的系统」——要绕开，不是攻破' },
                { k: '合规的拖字诀', v: '「等审批下来」——要最小可行治理' },
                { k: '自己的交付压力', v: '「先跑起来再说」——最容易死在这条' },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 13px', flexDirection: 'column', justifyContent: 'center', borderLeft: '3px solid #FBA15C' }}>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423' }}>{x.k}</Text>
                    <Text style={{ fontSize: 11, color: '#3A4050', lineHeight: 1.35, marginTop: 5 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · FDE咨询方法论</Text>
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 'auto' }}>08 / 60</Text>
    </Box>
</Slide>
