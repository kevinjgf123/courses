<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            失败现场一：<span style={{ color: '#FA4F24' }}>技术正确，运营无关</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            Delta 单独干时的默认结局。系统跑得很漂亮，但客户业务从不使用它
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    <Box style={{ paddingTop: 20, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 13 }}>

        {/* 上：症状 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 11 }}>
            {[
                { k: '技术指标全绿', c: '#B8BCC4', d: '准确率 92%、响应 300ms、日处理百万级、零事故。放到任何评审会上都是满分。' },
                { k: '业务使用为零', c: '#8A8F99', d: '上线三个月，日活用户 0–2 人，且都是 FDE 自己点的。' },
                { k: '问不出原因', c: '#5A6070', d: '技术团队认为是业务不重视，业务认为是技术不好用。互相指责，项目进入维护状态。' },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 16px', flexDirection: 'column', justifyContent: 'center', borderTop: `3px solid ${x.c}` }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#3A4050', lineHeight: 1.3 }}>{x.k}</Text>
                    <Text style={{ fontSize: 12.5, color: '#5A6070', lineHeight: 1.5, marginTop: 12, flex: 1 }}>{x.d}</Text>
                </Box>
            ))}
        </Box>

        {/* 中：根因与对策 */}
        <Box style={{ height: 190, flexDirection: 'row', gap: 12 }}>
            <Box style={{ width: 468, background: '#0F1423', borderRadius: 4, padding: '0 18px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12, color: '#FBA15C', letterSpacing: 2 }}>四个根因与对应的 Echo 动作</Text>
                {[
                    { k: '痛点是编的', v: 'Echo 去追决策链，验证痛点是否真实存在' },
                    { k: '流程不对齐', v: 'Echo 跟作业员走一遍，找真实断点' },
                    { k: '没进流程', v: 'Echo 追问：这个结论会回到哪个动作里' },
                    { k: '没人担责', v: 'Echo 找到签字的人，把名字写进移交清单' },
                ].map((x) => (
                    <Box key={x.k} style={{ flexDirection: 'row', gap: 12, marginTop: 11, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#FBA15C', width: 84 }}>{x.k}</Text>
                        <Text style={{ fontSize: 12.5, color: 'rgba(255,255,255,0.85)', lineHeight: 1.4, flex: 1 }}>{x.v}</Text>
                    </Box>
                ))}
            </Box>

            <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '0 17px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#C43A17' }}>自检三问</Text>
                {[
                    '如果我今天离开，客户会继续用吗？',
                    '这个系统的结论，改变了谁的什么动作？',
                    '客户有没有一次因为它而改变过原有做法？',
                ].map((x, i) => (
                    <Box key={x} style={{ flexDirection: 'row', gap: 11, marginTop: 13, alignItems: 'flex-start' }}>
                        <Box style={{ width: 20, height: 20, borderRadius: 10, background: '#FA4F24', alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>{i + 1}</Text>
                        </Box>
                        <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.4, flex: 1 }}>{x}</Text>
                    </Box>
                ))}
                <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#C43A17', lineHeight: 1.4, marginTop: 14 }}>
                    三问答不出「是」，就是运营无关。
                </Text>
            </Box>
        </Box>

        {/* 下：预防机制 */}
        <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'stretch' }}>
            <Box style={{ width: 208, background: '#F7F7F8', borderRadius: 4, padding: '0 15px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#8A8F99' }}>预防机制</Text>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423', marginTop: 5, lineHeight: 1.4 }}>不靠事后复盘，靠事前设置</Text>
            </Box>
            {[
                { k: 'Echo 必须配对', v: '不进项目的 Echo，视同没配对' },
                { k: '使用量当指标', v: '把日活写进验收项，不是可选' },
                { k: '写回路径强制', v: '无写回路径的场景不许上线' },
                { k: '一周内复核', v: '上线第七天查使用量，不达标即整改' },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 14px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#C43A17' }}>{x.k}</Text>
                    <Text style={{ fontSize: 11, color: '#3A4050', lineHeight: 1.35, marginTop: 5 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · FDE咨询方法论</Text>
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 'auto' }}>33 / 60</Text>
    </Box>
</Slide>