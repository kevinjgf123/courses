<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            Bootcamp 五天：<span style={{ color: '#FA4F24' }}>把 FDE 方法压成可复制的最短闭环</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            它不是培训营，是一次真实的现场交付。第五天没有结业式，只有移交清单
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    <Box style={{ paddingTop: 20, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 13 }}>

        {/* 上：五天节奏条 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 10 }}>
            {[
                { d: 'D1', k: '现场', c: '#FA4F24', o: '进客户环境，见决策者' },
                { d: 'D2', k: '建模', c: '#E0641E', o: '对象、链接、密级' },
                { d: 'D3', k: '跑通', c: '#C43A17', o: '交出可运行应用' },
                { d: 'D4', k: '贴人', c: '#A83310', o: '作业员实际使用' },
                { d: 'D5', k: '移交', c: '#8A2A0D', o: '六件交付物签收' },
            ].map((x) => (
                <Box key={x.d} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 14px', flexDirection: 'column', justifyContent: 'center', borderTop: `3px solid ${x.c}` }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: x.c }}>{x.d}</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F1423', marginTop: 6 }}>{x.k}</Text>
                    <Text style={{ fontSize: 11.5, color: '#3A4050', lineHeight: 1.4, marginTop: 9, flex: 1 }}>{x.o}</Text>
                </Box>
            ))}
        </Box>

        {/* 中：三条硬约束 + 淘汰标准 */}
        <Box style={{ height: 190, flexDirection: 'row', gap: 12 }}>
            <Box style={{ width: 468, background: '#0F1423', borderRadius: 4, padding: '0 18px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12, color: '#FBA15C', letterSpacing: 2 }}>三条不可协商的硬约束</Text>
                {[
                    { k: '不脱产', v: 'Bootcamp 全程在客户现场，不在会议室' },
                    { k: '不放过', v: '当天提的方案当天拍板，不允许挂起等审批' },
                    { k: '不做全', v: '只做一个场景的一条链路，其余明确不做' },
                ].map((x) => (
                    <Box key={x.k} style={{ flexDirection: 'row', gap: 12, marginTop: 11, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#FBA15C', width: 62 }}>{x.k}</Text>
                        <Text style={{ fontSize: 12.5, color: 'rgba(255,255,255,0.85)', lineHeight: 1.4, flex: 1 }}>{x.v}</Text>
                    </Box>
                ))}
            </Box>

            <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '0 17px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#C43A17' }}>五天内被淘汰的三种表现</Text>
                {[
                    { k: '手不碰生产', v: '只让客户演示，FDE 自己没写一行现场代码' },
                    { k: '嘴不挖真相', v: '没跟作业员聊过，只听管理层汇报' },
                    { k: '心不回流', v: '交付完就走，没想过哪部分能变平台能力' },
                ].map((x) => (
                    <Box key={x.k} style={{ flexDirection: 'row', gap: 11, marginTop: 11, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#C43A17', width: 86 }}>{x.k}</Text>
                        <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.4, flex: 1 }}>{x.v}</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 下：与传统培训的区别 */}
        <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'stretch' }}>
            <Box style={{ width: 208, background: '#F7F7F8', borderRadius: 4, padding: '0 15px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#8A8F99' }}>与传统培训的区别</Text>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423', marginTop: 5, lineHeight: 1.4 }}>唯一标准是客户有没有在用</Text>
            </Box>
            {[
                { k: '课堂作业', v: '评委看的是分数' },
                { k: '方案评审', v: '评委看的是逻辑' },
                { k: 'Bootcamp', v: '客户看的是有没有人天天登录' },
            ].map((x, i) => (
                <Box key={x.k} style={{ flex: 1, background: i === 2 ? '#FFF3EE' : '#F7F7F8', borderRadius: 4, padding: '0 14px', flexDirection: 'column', justifyContent: 'center', borderLeft: i === 2 ? '4px solid #FA4F24' : 'none' }}>
                    <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: i === 2 ? '#C43A17' : '#5A6070' }}>{x.k}</Text>
                    <Text style={{ fontSize: 11.5, color: '#3A4050', lineHeight: 1.35, marginTop: 5 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · FDE咨询方法论</Text>
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 'auto' }}>28 / 60</Text>
    </Box>
</Slide>