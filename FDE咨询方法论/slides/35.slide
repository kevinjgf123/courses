<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
            失败现场三：<span style={{ color: '#FA4F24' }}>经验不回流，碎石路修成断头路</span>
        </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            项目漂亮地交付了，客户满意了，公司一点能力都没多。半年后第二个客户还要从零开始
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    <Box style={{ paddingTop: 20, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 13 }}>

        {/* 上：断头路机制 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 11 }}>
            {[
                { k: '第一段通了', c: '#FA4F24', d: '现场铺路完成，客户上线，使用量达标。FDE 也很自豪。' },
                { k: '第二段缺失', c: '#C43A17', d: '没有人负责把现场经验整理成平台提案——因为这不在任何人的 KPI 里。' },
                { k: '第三段断了', c: '#5A6070', d: '第二个同类客户到来，团队重新造一遍轮子，成本与第一个完全相同。' },
                { k: '结论', c: '#8A8F99', d: '碎石路没有连成高速公路，公司在用人力替代抽象。' },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 15px', flexDirection: 'column', justifyContent: 'center', borderTop: `3px solid ${x.c}` }}>
                    <Text style={{ fontSize: 15.5, fontWeight: 'bold', color: x.c }}>{x.k}</Text>
                    <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.5, marginTop: 11, flex: 1 }}>{x.d}</Text>
                </Box>
            ))}
        </Box>

        {/* 中：回流清单 */}
        <Box style={{ height: 190, flexDirection: 'row', gap: 12 }}>
            <Box style={{ width: 468, background: '#0F1423', borderRadius: 4, padding: '0 18px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 12, color: '#FBA15C', letterSpacing: 2 }}>离场前必须提交的五类回流物</Text>
                {[
                    { k: '本体骨架', v: '某类行业的标准对象与链接模型' },
                    { k: '管道模板', v: '含幂等、重试、批次号的成熟写法' },
                    { k: 'Agent 模板', v: '工具白名单、出口策略、记忆边界' },
                    { k: '验收清单', v: '十二项检查的同类行业改造版' },
                    { k: '坑位清单', v: '哪里踩过雷、为什么、下次怎么避' },
                ].map((x) => (
                    <Box key={x.k} style={{ flexDirection: 'row', gap: 12, marginTop: 10, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 11.5, fontWeight: 'bold', color: '#FBA15C', width: 68 }}>{x.k}</Text>
                        <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.85)', lineHeight: 1.35, flex: 1 }}>{x.v}</Text>
                    </Box>
                ))}
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
                <Box style={{ flex: 1, background: '#FFF3EE', borderRadius: 4, borderLeft: '4px solid #FA4F24', padding: '0 16px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#C43A17' }}>回流之所以不发生，是因为没定责任</Text>
                    {[
                        '客户现场的人不会主动整理——他下周就换项目了',
                        '总部 Dev 不知道现场做了什么——没人通知他',
                        '管理层不考核这项——所以它永远排在最后',
                    ].map((x) => (
                        <Box key={x} style={{ flexDirection: 'row', gap: 10, marginTop: 10, alignItems: 'flex-start' }}>
                            <Box style={{ width: 5, height: 5, borderRadius: 3, background: '#FA4F24', marginTop: 6 }} />
                            <Text style={{ fontSize: 12.5, color: '#3A4050', lineHeight: 1.4, flex: 1 }}>{x}</Text>
                        </Box>
                    ))}
                </Box>
                <Box style={{ height: 64, background: '#F7F7F8', borderRadius: 4, padding: '0 15px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F1423', width: 108 }}>制度性解法</Text>
                    <Text style={{ fontSize: 11.5, color: '#3A4050', lineHeight: 1.4, flex: 1 }}>
                        回流提案不签字，项目不算关闭。这一条要写进交付流程，而不是靠个人自觉。
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 下：可复用度指标 */}
        <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'stretch' }}>
            <Box style={{ width: 208, background: '#F7F7F8', borderRadius: 4, padding: '0 15px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#8A8F99' }}>管理上唯一的抓手</Text>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0F1423', marginTop: 5, lineHeight: 1.4 }}>复用率</Text>
            </Box>
            {[
                { k: 'A 档占比', v: '交付内容里可通用部分的比例' },
                { k: '二次成本', v: '第二客户投入 ÷ 第一客户投入' },
                { k: '回流及时', v: '离场后两周内提案是否到总部' },
                { k: '采纳率', v: '总部真正采纳并入平台的比例' },
            ].map((x) => (
                <Box key={x.k} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 14px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#C43A17' }}>{x.k}</Text>
                    <Text style={{ fontSize: 11, color: '#3A4050', lineHeight: 1.35, marginTop: 5 }}>{x.v}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 14, height: 14, background: '#FA4F24' }} />
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · FDE咨询方法论</Text>
        <Text style={{ fontSize: 14, color: '#8A8F99', marginLeft: 'auto' }}>35 / 60</Text>
    </Box>
</Slide>