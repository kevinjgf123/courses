<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
     <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
      之内容：DA 视角 —— <span style={{ color: '#FA4F24' }}>本体不另存一份数据</span>，只存定义与映射
     </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
            这是本体与传统数据建模最大的分歧点，也是最容易被架构师质疑的一条
      </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    <Box style={{ paddingTop: 22, paddingBottom: 12, height: 479, flexDirection: 'row', gap: 18 }}>
   {/* 左 工程等价 */}
        <Box style={{ width: 500, flexDirection: 'column', gap: 8 }}>
     <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423' }}>与实体数据模型的工程等价</Text>
  {[
    { a: 'Dataset Schema', b: 'Object Type', d: '字段与类型的定义方式高度相似' },
      { a: 'Row / Record', b: 'Object Instance', d: '对象实例就是数据行，只是换了业务名' },
 { a: 'Foreign Key / Join', b: 'Link Type', d: '链接可带属性，比外键表达力更强' },
    { a: 'View / Materialized View', b: 'Object Set', d: '动态对象集 ≈ 运行时筛选结果' },
  ].map((it, i) => (
  <Box key={i} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 16px', flexDirection: 'column', justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
   <Text style={{ fontSize: 13, fontFamily: 'monospace', color: '#8A8F99', width: 150 }}>{it.a}</Text>
   <Text style={{ fontSize: 13, color: '#FA4F24' }}>≈</Text>
     <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0F1423', flex: 1 }}>{it.b}</Text>
     </Box>
  <Text style={{ fontSize: 12, color: '#3A4050', lineHeight: 1.4, marginTop: 4 }}>{it.d}</Text>
   </Box>
   ))}
    <Box style={{ height: 72, background: '#0F1423', borderRadius: 4, padding: '12px 16px', flexDirection: 'column', justifyContent: 'center' }}>
       <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FBA15C' }}>哲学上的差别</Text>
   <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.9)', lineHeight: 1.5, marginTop: 5 }}>
      数据建模关注「变化中的不变」——字段存进库就稳定；本体关注「变化中的实体」——设备归属会变、订单状态会变、客户会重组，但对象身份不变。
    </Text>
     </Box>
        </Box>

   {/* 右 存储策略 + 风险 */}
   <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423' }}>存储策略：不复制数据的后果与代价</Text>
            <Box style={{ height: 128, background: '#FFF3EE', borderRadius: 4, padding: '12px 16px', flexDirection: 'column', justifyContent: 'center', gap: 8 }}>
          {[
  { t: '数据进平台后持久化落地', d: '原始与加工后的数据集都在，作为唯一事实来源' },
   { t: '对象层只存定义与指向', d: '查属性时读底层数据集，不另存一份完整副本' },
     { t: '用户编辑走对象层', d: '用户改动叠加在数据源之上，由数据漏斗保持索引最新' },
   ].map((it, i) => (
       <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
     <Box style={{ width: 5, height: 5, background: '#FA4F24', borderRadius: 3, marginTop: 6 }} />
        <Text style={{ fontSize: 13, color: '#3A2000', flex: 1, lineHeight: 1.45 }}>
        <Text style={{ fontWeight: 'bold' }}>{it.t}</Text>　{it.d}
  </Text>
     </Box>
  ))}
       </Box>
       <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423', marginTop: 4 }}>架构评审要问的三个问题</Text>
            {[
    { t: '数据源还没到位就先建了对象？', d: '建模与取数必须同步推进，否则模型会大面积返工' },
    { t: '同一对象跨几个源系统？', d: '主数据归属必须先定，否则会出现互相打架的两份主档' },
      { t: '历史数据与实时数据怎么切？', d: '对象属性有新旧口径时，要用有效期而不是覆盖历史' },
    ].map((it, i) => (
      <Box key={i} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 16px', flexDirection: 'column', justifyContent: 'center', borderLeft: '4px solid #FA4F24' }}>
     <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0F1423' }}>{it.t}</Text>
   <Text style={{ fontSize: 13, color: '#3A4050', lineHeight: 1.4, marginTop: 3 }}>{it.d}</Text>
    </Box>
  ))}
        </Box>
    </Box>

    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
    <Box style={{ width: 10, height: 10, background: '#FA4F24' }} />
 <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · Ontology本体咨询方法论</Text>
    <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 'auto' }}>14 / 30</Text>
    </Box>
</Slide>