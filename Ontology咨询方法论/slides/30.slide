      <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FA4F24', marginBottom: 6 }}>最常踩的五个坑</Text>
     {[
  { t: '先建全量模型再找场景', d: '结果是一个没人用的大图' },
    { t: '只建语义不建行动', d: '结果是一张漂亮但推不动的图' },
  { t: '动作定义在应用里', d: '结果每接一个系统改一次' },
     { t: '权限只做到页面', d: '结果一次穿透，AI 接入直接停摆' },
      { t: '双轨没有退出日期', d: '结果永远并行，系统数量翻倍' },
        ].map((it, i) => (
  <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
   <Box style={{ width: 5, height: 5, background: '#FA4F24', borderRadius: 3 }} />
       <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', width: 186 }}>{it.t}</Text>
      <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.75)', flex: 1, lineHeight: 1.3 }}>{it.d}</Text>
     </Box>
   ))}
   </Box>

    <Box style={{ background: 'linear-gradient(160deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '16px 18px', flexDirection: 'column', flex: 1.4, justifyContent: 'center' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>全册收束</Text>
   {[
     'BA 说清要做什么决策',
     'DA 说清数据从哪来',
    'AA 说清谁在用',
        'TA 说清跑不跑得动',
      ].map((t, i) => (
