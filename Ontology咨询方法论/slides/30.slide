    <Box style={{ position: 'absolute', right: 0, top: 0, width: 560, height: 720, background: 'linear-gradient(200deg, rgba(250,79,36,0.28) 0%, rgba(250,79,36,0) 70%)' }} />

    <Box style={{ position: 'absolute', left: 64, top: 46, right: 64, height: 118, flexDirection: 'column' }}>
    <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.5)', letterSpacing: 3 }}>结语</Text>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', marginTop: 14, lineHeight: 1.35 }}>
     接三种集成模式、走四步演进、避五个坑 —— <span style={{ color: '#FA4F24' }}>本体是长出来的，不是建出来的</span>
    </Text>
 </Box>

  <Box style={{ position: 'absolute', left: 64, top: 176, width: 640, height: 470, flexDirection: 'column', gap: 10 }}>
      <Box style={{ background: 'rgba(255,255,255,0.06)', borderRadius: 4, padding: '12px 14px', flexDirection: 'column', flex: 1 }}>
   <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 6 }}>
       <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FA4F24' }}>与已有数据中层的三种接法</Text>
  <Box style={{ flex: 1, height: 1, background: 'rgba(255,255,255,0.16)' }} />
   </Box>
   {[
  { t: '作为消费方', d: '接进现有数仓的加工结果', m: '推荐：矛盾最小，见效最快' },
        { t: '并行双轨', d: '两边同时跑，先对齐数据目录口径', m: '过渡方案：必须设退出日期' },
     { t: '承担中台职能', d: '本体平台自己就是中台', m: '只有数据治理已成熟才可考虑' },
        ].map((it, i) => (
   <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF', width: 116 }}>{it.t}</Text>
     <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.72)', flex: 1, lineHeight: 1.35 }}>{it.d}</Text>
      <Text style={{ fontSize: 12, color: '#FBA15C', width: 178, lineHeight: 1.3 }}>{it.m}</Text>
    </Box>
   ))}
      </Box>

        <Box style={{ background: 'rgba(255,255,255,0.06)', borderRadius: 4, padding: '12px 14px', flexDirection: 'column', flex: 1.25 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FA4F24' }}>演进四步与每步的退出条件</Text>
   <Box style={{ flex: 1, height: 1, background: 'rgba(255,255,255,0.16)' }} />
     </Box>
        {[
        { n: '一', t: '单场景只读', x: '业务方能无歧义复述每个对象' },
      { n: '二', t: '单场景可写', x: '写回成功率可验证，回滚演练过' },
   { n: '三', t: '单域成体系', x: '本域动作收齐，权限矩阵无空白' },
      { n: '四', t: '跨域 + AI', x: 'AI 全程只经动作，不越权' },
        ].map((it, i) => (
          <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
  <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FA4F24', width: 24 }}>{it.n}</Text>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF', width: 146 }}>{it.t}</Text>
     <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.75)', flex: 1, lineHeight: 1.35 }}>{it.x}</Text>
    {i < 3 && <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.3)' }}>→</Text>}
   </Box>
   ))}
   </Box>
    </Box>

    {/* 右：五个坑 + 主线收束 */}
    <Box style={{ position: 'absolute', left: 736, top: 176, width: 480, height: 470, flexDirection: 'column', gap: 10 }}>
