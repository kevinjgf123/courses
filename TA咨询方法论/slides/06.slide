<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
   <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
   之内容：<span style={{ color: '#FA4F24' }}>四个视图的架构表达体系</span>，一份技术架构画四遍
    </Text>
    <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
      组件视图 · 部署视图 · 数据视图 · 运维视图，各回答一个不能互相替代的问题
    </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 10 }}>
      {[
    { v: '①', t: '组件视图', q: '有哪些技术组件，谁提供、谁依赖',
         d: '回答「用什么」。产出技术组件清单与依赖矩阵，是整个 TA 的地基',
         pts: ['组件要标版本、标来源、标锁定风险', '公共组件必须列全，否则各团队会各自造一套'], c: '#0F1423' },
      { v: '②', t: '部署视图', q: '跑在哪里，怎么分环境、怎么跨可用区',
     d: '回答「放哪」。产出环境拓扑与资源基线，是故障切换的依据',
         pts: ['区分环境：开发 / 测试 / 预发 / 生产，配置必须隔离', '生产至少双可用区，重要系统同城双活'], c: '#FA4F24' },
        { v: '③', t: '数据视图', q: '技术层的数据流向与存储分布',
       d: '回答「怎么存、怎么流」。与 DA 的资产目录对齐，产出存储分层与备份策略',
         pts: ['冷热分层要在这一层定，落地才有人执行', '备份不是「拷了一份」，要有恢复演练时间'], c: '#F8622F' },
        { v: '④', t: '运维视图', q: '怎么监控、怎么告警、怎么定位',
         d: '回答「怎么管」。产出可观测性方案，是可用性的真实保障',
    pts: ['四个信号：日志、指标、链路、事件，缺一个定位就会瞎', '告警要能对应到责任人，否则只是噪声'], c: '#FBA15C' },
      ].map((it, i) => (
        <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', gap: 14 }}>
  <Box style={{ width: 52, background: it.c, borderRadius: 4, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>{it.v}</Text>
     </Box>
  <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 18px', flexDirection: 'column', justifyContent: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 16 }}>
   <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F1423', width: 96 }}>{it.t}</Text>
   <Text style={{ fontSize: 14, fontWeight: 'bold', color: it.c, width: 250 }}>{it.q}</Text>
    <Text style={{ fontSize: 13, color: '#3A4050', flex: 1, lineHeight: 1.4 }}>{it.d}</Text>
         </Box>
 <Box style={{ flexDirection: 'row', gap: 20, marginTop: 5 }}>
 {it.pts.map((p, j) => (
   <Text key={j} style={{ fontSize: 12, color: '#5A6072', flex: 1, lineHeight: 1.35 }}>· {p}</Text>
          ))}
   </Box>
     </Box>
 </Box>
      ))}
   <Box style={{ height: 66, background: 'linear-gradient(90deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '0 18px', flexDirection: 'row', alignItems: 'center' }}>
    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', width: 200 }}>★ 四个视图不是四份文档</Text>
        <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.95)', flex: 1, lineHeight: 1.45 }}>
        它们共用同一份组件清单。任何一层视图里出现的组件，都必须在清单里有登记；
    清单里有的组件，也必须在至少一张视图里出现。对不上，说明架构和现实已经脱节。
        </Text>
    </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 10, height: 10, background: '#FA4F24' }} />
    <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · TA技术架构咨询方法论</Text>
     <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 'auto' }}>06 / 30</Text>
    </Box>
</Slide>