<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
   之方法：<span style={{ color: '#FA4F24' }}>技术标准四条</span>，标准是资产，产品是耗材
  </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
     不用管选了什么技术，只管这四件事有没有统一口径
    </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 24, paddingBottom: 14, height: 479, flexDirection: 'column', gap: 11 }}>
 {[
     { n: '01', t: '接口标准', c: '#0F1423', tc: '#FFFFFF',
    d: '跨团队调用必须走统一样式：协议、鉴权、错误码、超时、重试',
        pts: ['要求：新人照着文档就能接入，不需要问人', '反例：每个团队一套返回结构，异常时没人知道该看哪个字段'] },
        { n: '02', t: '编码与交付标准', c: '#FA4F24', tc: '#FFFFFF',
     d: '目录结构、命名、日志、提交、构建、发布流程全公司一致',
      pts: ['要求：任何仓库 clone 下来都能一条命令构建', '反例：构建脚本依赖某人的本地环境，新人第一天就卡住'] },
        { n: '03', t: '部署与环境标准', c: '#F8622F', tc: '#FFFFFF',
     d: '镜像规范、资源配置、环境变量、密钥管理方式统一',
    pts: ['要求：所有服务无差别部署，不靠本地特权', '反例：某个系统必须登录特定跳板机才能发布'] },
   { n: '04', t: '可观测性标准', c: '#FBA15C', tc: '#FFFFFF',
        d: '日志格式、指标命名、链路追踪、告警规则统一',
        pts: ['要求：故障时一次查询能看到全部相关服务', '反例：三个团队三套日志格式，故障时先花一小时找日志'] },
      ].map((it, i) => (
      <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'stretch', gap: 14 }}>
    <Box style={{ width: 118, background: it.c, borderRadius: 4, alignItems: 'center', justifyContent: 'center', flexDirection: 'column' }}>
    <Text style={{ fontSize: 13, fontWeight: 'bold', color: it.tc, letterSpacing: 1 }}>{it.n}</Text>
   <Text style={{ fontSize: 18, fontWeight: 'bold', color: it.tc, marginTop: 3 }}>{it.t}</Text>
   </Box>
  <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 18px', flexDirection: 'column', justifyContent: 'center' }}>
    <Text style={{ fontSize: 15, color: '#0F1423', lineHeight: 1.4 }}>{it.d}</Text>
        <Text style={{ fontSize: 13, color: '#5A6072', lineHeight: 1.4, marginTop: 4 }}>{it.pts[0]}</Text>
      <Text style={{ fontSize: 13, color: '#C43A17', lineHeight: 1.4, marginTop: 2 }}>{it.pts[1]}</Text>
   </Box>
    {i < 3 && (
     <Box style={{ width: 24, alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 16, color: '#FA4F24', fontWeight: 'bold' }}>›</Text>
     </Box>
   )}
      </Box>
   ))}
        <Box style={{ height: 58, background: '#0F1423', borderRadius: 4, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
     <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FBA15C', width: 180 }}>★ 判断标准有没有效</Text>
   <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.9)', flex: 1, lineHeight: 1.45 }}>
      不看文档写了多少条，看新人第一次交付要问几个人。问超过三个人，说明标准没落到工具上，
      只是文档而已。标准必须能被人和工具同时执行，才叫标准。
        </Text>
     </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 10, height: 10, background: '#FA4F24' }} />
   <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · TA技术架构咨询方法论</Text>
        <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 'auto' }}>21 / 30</Text>
    </Box>
</Slide>