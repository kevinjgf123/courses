<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
    之内容：<span style={{ color: '#FA4F24' }}>容量三档与成本账</span>，把「要多少」算出来
      </Text>
     <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
      当前量 / 三年预测量 / 峰谷比 —— 三个数决定这一层投多少
        </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 22, paddingBottom: 12, height: 479, flexDirection: 'row', gap: 20 }}>
        {/* 左 三档 */}
     <Box style={{ width: 470, flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423' }}>三档容量怎么定</Text>
     {[
     { n: '当前档', v: '按最近 12 个月实际峰值', u: '订单中心 1200 TPS', c: '#0F1423', tc: '#FFFFFF' },
       { n: '规划档', v: '按三年业务预测 + 新系统上线', u: '订单中心 3000 TPS', c: '#FA4F24', tc: '#FFFFFF' },
     { n: '峰谷比', v: '峰值是否为均值的倍数，决定要不要弹性', u: '峰值 4.2×均值 → 必须弹性', c: '#FBA15C', tc: '#3A2000' },
      ].map((it, i) => (
     <Box key={i} style={{ flex: 1, background: it.c, borderRadius: 4, padding: '0 16px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
       <Text style={{ fontSize: 18, fontWeight: 'bold', color: it.tc, width: 74 }}>{it.n}</Text>
 <Box style={{ flex: 1, flexDirection: 'column' }}>
       <Text style={{ fontSize: 12, color: it.tc, opacity: 0.9 }}>{it.v}</Text>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: it.tc, marginTop: 3 }}>{it.u}</Text>
  </Box>
 </Box>
       ))}
    <Box style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '12px 16px', flexDirection: 'column', justifyContent: 'center', borderLeft: '4px solid #FA4F24' }}>
     <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C43A17' }}>峰谷比是选型的分水岭</Text>
   <Text style={{ fontSize: 13, color: '#3A4050', lineHeight: 1.55, marginTop: 3 }}>
   峰谷比低于 2，按峰值固定配置最省。高于 4，就必须做弹性伸缩——
   按峰值买全年，成本会翻倍；不弹性，成本全压在峰谷差上。
     </Text>
        </Box>
      </Box>

   {/* 右 成本账 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
     <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F1423' }}>成本账要算三笔</Text>
       {[
        { t: '① 一次性投入', d: '机房 / 硬件 / 平台建设 / 迁移人力', v: '约 800 万', c: '#0F1423' },
    { t: '② 三年运行', d: '含扩容、许可、运维人力、能耗', v: '约 3600 万', c: '#FA4F24' },
      { t: '③ 不做的代价', d: '业务增长被卡住的损失、返工成本', v: '约 1.1 亿', c: '#FBA15C' },
       ].map((it, i) => (
        <Box key={i} style={{ flex: 1, background: '#F7F7F8', borderRadius: 4, padding: '0 16px', flexDirection: 'row', alignItems: 'center', gap: 14, borderLeft: `5px solid ${it.c}` }}>
 <Text style={{ fontSize: 15, fontWeight: 'bold', color: it.c, width: 108 }}>{it.t}</Text>
     <Text style={{ fontSize: 12, color: '#3A4050', flex: 1, lineHeight: 1.4 }}>{it.d}</Text>
     <Text style={{ fontSize: 16, fontWeight: 'bold', color: it.c, width: 84, textAlign: 'right' }}>{it.v}</Text>
    </Box>
       ))}
     <Box style={{ flex: 1.3, background: 'linear-gradient(160deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '14px 16px', flexDirection: 'column', justifyContent: 'center' }}>
     <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>第三笔最容易被忽略</Text>
     <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.95)', lineHeight: 1.6, marginTop: 5 }}>
     只算前两笔的投资回报，怎么算都不划算。但如果把「不做的代价」写进去，
 结论通常会反过来。技术架构的投入之所以难批，
   一大半原因是这份账从来没被认真做过。
     </Text>
   </Box>
   </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 10, height: 10, background: '#FA4F24' }} />
      <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · TA技术架构咨询方法论</Text>
      <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 'auto' }}>18 / 30</Text>
    </Box>
</Slide>