<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '24px 64px 0' }}>
    {/* A 区 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'flex-start' }}>
   <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0F1423' }}>
   五个把技术架构<span style={{ color: '#FA4F24' }}>做砸</span>的坑
      </Text>
        <Text style={{ fontSize: 20, color: '#8A8F99', marginTop: 8 }}>
     每一个的代价，都是在换代那天一次性结账
      </Text>
    </Box>
    <Box style={{ height: 1, background: '#E8E8E8' }} />

    {/* B 区 */}
    <Box style={{ paddingTop: 22, paddingBottom: 12, height: 479, flexDirection: 'column', gap: 8 }}>
  {[
  { n: '01', t: '把技术架构等同于机房建设', d: '画了机房图和服务器清单，没有分层也没有标准', w: '后果：技术换代时无从下手，业务直接受冲击', c: '#0F1423' },
        { n: '02', t: '只盘组件，不定标准', d: '清单列得很全，但没有版本策略，也没有替换计划', w: '后果：清单变成一张谁也用不上的技术名词表', c: '#3A4050' },
        { n: '03', t: '非功能需求全是形容词', d: '高可用、高性能、灵活扩展，没有一个数字', w: '后果：验收无据，事故时责任无法界定', c: '#5A6072' },
        { n: '04', t: '标准只写文档不接工具', d: '规范写得很好，但流水线不校验、代码不扫描', w: '后果：三个月后无人遵守，标准形同虚设', c: '#FA4F24' },
 { n: '05', t: '技术路线永远在起跑线', d: '每年都在做数字化转型，容器化率一直卡在个位数', w: '后果：欠账越积越厚，架构只存在于汇报材料里', c: '#F8622F' },
    ].map((it, i) => (
      <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', background: '#F7F7F8', borderRadius: 4, padding: '0 18px', gap: 16, borderLeft: `5px solid ${it.c}` }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: it.c, width: 34 }}>{it.n}</Text>
    <Box style={{ flex: 1, flexDirection: 'column' }}>
  <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F1423' }}>{it.t}</Text>
     <Text style={{ fontSize: 13, color: '#3A4050', marginTop: 2, lineHeight: 1.4 }}>{it.d}</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#C43A17', width: 320, lineHeight: 1.45 }}>{it.w}</Text>
        </Box>
  ))}
  <Box style={{ height: 62, background: 'linear-gradient(90deg, #FA4F24 0%, #F87D2F 100%)', borderRadius: 4, padding: '0 18px', flexDirection: 'row', alignItems: 'center' }}>
   <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', width: 190 }}>五个坑的共同根因</Text>
     <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.95)', flex: 1, lineHeight: 1.45 }}>
  把技术架构当成「今年要买什么」，而不是「未来三年怎么不被换掉」。
     买什么是一次性投入，怎么不被换掉才是长期资产。
    </Text>
      </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 58, flexDirection: 'row', alignItems: 'center', borderTop: '1px solid #E8E8E8' }}>
        <Box style={{ width: 10, height: 10, background: '#FA4F24' }} />
        <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 12 }}>硕磐机密 · TA技术架构咨询方法论</Text>
    <Text style={{ fontSize: 13, color: '#8A8F99', marginLeft: 'auto' }}>29 / 30</Text>
    </Box>
</Slide>